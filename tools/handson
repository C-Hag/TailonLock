def evidence_hash(n, evidence):
    """sha256 over the evidence line and every file the item left in its folder (build/handson/itemN)"""
    import hashlib
    h = hashlib.sha256(evidence.encode('utf-8'))
    d = os.path.join(OUT, 'item%d' % n)
    for root, _, files in sorted(os.walk(d)):
        for name in sorted(files):
            if name.endswith('.log') or name.endswith('.out'):
                h.update(name.encode('utf-8'))
                with open(os.path.join(root, name), 'rb') as f:
                    h.update(f.read())
    return h.hexdigest()


def commit_of(given):
    """The commit: git's answer, or --commit where there is no git. Both, and they must agree."""
    try:
        rc = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=ROOT, capture_output=True, text=True)
        have = rc.stdout.strip() if rc.returncode == 0 else ''
    except OSError:
        have = ''
    if have and given and have != given:
        sys.exit('handson: --commit %s, but git says this tree is %s' % (given, have))
    full = have or given
    if not re.fullmatch(r'[0-9a-f]{40}', full or ''):
        sys.exit('handson: --cert needs the commit: no git here, so give --commit and the full 40-digit id')
    return full


def write_cert(rows, full):
    """certs/<commit>-hands-on-<system>.md: docs/TEST_GUIDE.md section 5, a box ticked only on PASS (or n/a, for what
    the game does not support yet) with its evidence line and hash; tools/certify release reads the boxes"""
    import platform
    sysname = {'Darwin': 'macos', 'Linux': 'linux', 'Windows': 'windows'}.get(platform.system(), platform.system().lower())
    path = os.path.join(ROOT, 'certs', '%s-hands-on-%s.md' % (full[:12], sysname))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write('# Hands-on checks, %s, commit %s\n\nFlown by tools/handson (docs/TEST_GUIDE.md section 5), %s. A box is '
                'ticked only on PASS, with its evidence and the sha256 of the evidence and its logs; n/a is a feature '
                'the game does not have yet.%s\n\n' % (sysname, full, time.strftime('%Y-%m-%d %H:%M'), scale_note()))
        for n, name, verdict, ev, digest in rows:
            if n > 17:
                continue
            box = 'x' if verdict in ('PASS', 'N/A') else ' '
            f.write('- [%s] %d. %s: %s. %s (sha256 %s)\n' % (box, n, name, verdict, ev, digest[:16]))
    return path


def scale_note():
    return ' Time limits on game runs times %d, for this computer\'s speed.' % TIME_SCALE if TIME_SCALE != 1 else ''


def main():
    global EXE, BUILD, TIME_SCALE
    args = sys.argv[1:]
    BUILD = os.path.join(ROOT, 'build', 'linux-release')
    report = os.path.join(OUT, 'report.md')
    only, cert, given, scale = None, False, None, None
    i = 0
    while i < len(args):
        if args[i] == '--build':
            BUILD = os.path.abspath(args[i + 1])
            i += 1
        elif args[i] == '--report':
            report = os.path.abspath(args[i + 1])
            i += 1
        elif args[i] == '--only':
            only = {int(v) for v in args[i + 1].split(',')}
            i += 1
        elif args[i] == '--cert':
            cert = True
        elif args[i] == '--commit':
            given = args[i + 1]
            i += 1
        elif args[i] == '--time-scale':
            scale = int(args[i + 1])
            if scale < 1:
                sys.exit('handson: --time-scale is 1 or more')
            i += 1
        i += 1
    EXE = os.path.join(BUILD, 'tailonlock')
    mac = os.path.join(BUILD, 'TailonLock.app', 'Contents', 'MacOS', 'TailonLock')  # the macOS build is an app
    win = os.path.join(BUILD, 'TailonLock.exe')
    if not os.path.isfile(EXE) and os.path.isfile(mac):
        EXE = mac
    elif sys.platform == 'win32' and os.path.isfile(win):
        EXE = win
    full = commit_of(given) if cert else None  # before the run, not after an hour of it
    os.makedirs(OUT, exist_ok=True)
    TIME_SCALE = scale or measure_time_scale()
    if TIME_SCALE != 1:
        print('time limits times %d, for this computer\'s speed' % TIME_SCALE, flush=True)
    rows, failed = [], 0
    for n, name, fn in ITEMS:
        if only and n not in only:
            continue
        t0 = time.time()
        ok, evidence = fn()
        verdict = 'SKIP' if ok is None else 'N/A' if ok == 'n/a' else 'PASS' if ok else 'FAIL'
        failed += verdict == 'FAIL'
        print('[%2d] %-4s %s (%.0f s)\n     %s' % (n, verdict, name, time.time() - t0, evidence), flush=True)
        rows.append((n, name, verdict, evidence, evidence_hash(n, evidence)))
    with open(report, 'w') as f:
        f.write('# Hands-on checklist, flown by the test pilots\n\n%s, build %s.%s\n\n| # | Item | Result | Evidence |\n'
                '|---|---|---|---|\n' % (time.strftime('%Y-%m-%d %H:%M'), os.path.relpath(BUILD, ROOT), scale_note()))
        for n, name, verdict, ev, _ in rows:
            f.write('| %d | %s | %s | %s |\n' % (n, name, verdict, ev.replace('|', '/')))
    print('report: ' + os.path.relpath(report, ROOT))
    if cert:
        print('certificate: ' + os.path.relpath(write_cert(rows, full), ROOT))
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
