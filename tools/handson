# ---- the network items: two copies on this computer, through tools/playtest's own helpers --------------------
def playtest():
    """tools/playtest as a module (its game_env, game_args, wait_code, compare and bad-net proxy)"""
    import importlib.machinery
    import importlib.util
    path = os.path.join(ROOT, 'tools', 'playtest')
    loader = importlib.machinery.SourceFileLoader('playtest', path)
    spec = importlib.util.spec_from_loader('playtest', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def lan_ports_free():
    """the LAN game port and the beacons' are free (the certificate's network runs use them too)"""
    import socket
    for port in (27960, 27961):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.bind(('', port))
        except OSError:
            return False
        finally:
            s.close()
    return True


def side(pt, d, who, args, games):
    """starts one side in its own folder; returns (process, log path)"""
    home = os.path.join(d, who + '-home')
    os.makedirs(home, exist_ok=True)
    log = os.path.join(d, who + '.log')
    e = pt.game_env(home, log)
    e['TL_STATE'] = '1'
    out = open(os.path.join(d, who + '.out'), 'w')
    return subprocess.Popen([EXE] + args, env=e, stdout=out, stderr=subprocess.STDOUT, cwd=d), log


def match_args(pt, seed, games, lives=1):
    """a short match: one jet each, one life (the CPU pilots finish it in a minute or two)"""
    return pt.game_args(seed, ['match=vs', 'size=1v1', 'start=air'], games, 900) + ['--set', 'planes=%d' % lives]


def finish(procs, timeout):
    end = time.monotonic() + limit(timeout)
    for p in procs:
        try:
            p.wait(timeout=max(1, end - time.monotonic()))
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()


def text(path):
    try:
        return open(path, encoding='utf-8', errors='replace').read()
    except OSError:
        return ''


def item_dir(n):
    d = os.path.join(OUT, 'item%d' % n)
    shutil.rmtree(d, ignore_errors=True)
    os.makedirs(d)
    return d


def no_address(line):
    """The list goes in a public release: this computer's network address stays out of it (the logs keep it)."""
    return re.sub(r'\b\d{1,3}(\.\d{1,3}){3}(:\d+)?', '<LAN address>', line)


def item13():
    """LAN: the host's game shows up in the other copy's list, which joins it with the code; a match, then a rematch,
    and both copies agree on both."""
    if not lan_ports_free():
        return None, 'UDP 27960/27961 in use (another copy or the certificate is hosting): run again when free'
    pt, d = playtest(), item_dir(13)
    host, hlog = side(pt, d, 'host', ['--host'] + match_args(pt, 13, 2), 2)
    code = pt.wait_code(hlog, host)
    if not code:
        finish([host], 1)
        return False, 'the host made no game code'
    guest, glog = side(pt, d, 'guest', ['--join', 'lan', '--code', code] + match_args(pt, 13, 2), 2)
    finish([host, guest], 900)
    listed = re.search(r'net: in the LAN list: (.+)', text(glog))
    rows, probs = pt.compare(hlog, glog, 2, host.returncode, guest.returncode)
    ok = bool(listed) and not probs and len(rows) == 2
    return ok, 'the guest\'s list showed "%s"; joined with code %s; %d matches (the second a rematch) agreed%s' % (
        no_address(listed.group(1)) if listed else 'nothing', code, len(rows), '; ' + '; '.join(probs) if probs else '')


def item14():
    """A wrong code is refused with a message on both sides; the right code then joins and plays."""
    if not lan_ports_free():
        return None, 'UDP 27960/27961 in use (another copy or the certificate is hosting): run again when free'
    pt, d = playtest(), item_dir(14)
    host, hlog = side(pt, d, 'host', ['--host'] + match_args(pt, 14, 1), 1)
    code = pt.wait_code(hlog, host)
    if not code:
        finish([host], 1)
        return False, 'the host made no game code'
    wrong = '%06d' % ((int(code) + 1) % 1000000)
    bad, blog = side(pt, d, 'wrong', ['--join', '127.0.0.1', '--code', wrong, '--seconds', '12'] + match_args(pt, 14, 1), 1)
    finish([bad], 30)
    refused = re.search(r'net: ((?:WRONG GAME CODE|THE HOST DID NOT LET US IN)[^\n]*)', text(blog))
    told = re.search(r'net: (SOMEONE TRIED A WRONG CODE[^\n]*)', text(hlog))
    guest, glog = side(pt, d, 'guest', ['--join', '127.0.0.1', '--code', code] + match_args(pt, 14, 1), 1)
    finish([host, guest], 600)
    rows, probs = pt.compare(hlog, glog, 1, host.returncode, guest.returncode)
    ok = bool(refused) and bool(told) and not probs and len(rows) == 1
    return ok, 'code %s refused: guest "%s", host "%s"; then code %s: %d match agreed%s' % (
        wrong, refused.group(1) if refused else 'no message', told.group(1) if told else 'no message', code, len(rows),
        '; ' + '; '.join(probs) if probs else '')


def item15():
    """The cable pulled mid-match (a proxy between the copies drops everything): CONNECTION LOST on both within 6 s,
    both back at the menu, and a new game hosted on the same port then plays."""
    if not lan_ports_free():
        return None, 'UDP 27960/27961 in use (another copy or the certificate is hosting): run again when free'
    pt, d = playtest(), item_dir(15)
    host, hlog = side(pt, d, 'host', ['--host'] + match_args(pt, 15, 1, lives=5), 1)
    code = pt.wait_code(hlog, host)
    if not code:
        finish([host], 1)
        return False, 'the host made no game code'
    proxy = pt.BadNet(('127.0.0.1', 27960), 15, delay=(0.001, 0.002), loss=0, dup=0)
    guest, glog = side(pt, d, 'guest', ['--join', '127.0.0.1:%d' % proxy.port, '--code', code] + match_args(pt, 15, 1, lives=5), 1)
    end = time.monotonic() + 60
    while time.monotonic() < end and not ('STATE play' in text(hlog) and 'STATE play' in text(glog)):
        time.sleep(0.2)
    time.sleep(8)  # well into the match
    proxy.blackhole = True
    t0, lost = time.monotonic(), {}
    while time.monotonic() < t0 + 15 and len(lost) < 2:
        for who, log in (('host', hlog), ('guest', glog)):
            if who not in lost and 'CONNECTION LOST' in text(log):
                lost[who] = time.monotonic() - t0
        time.sleep(0.1)
    time.sleep(1)
    menu = {who: bool(re.search(r'CONNECTION LOST.*?STATE menu', text(log), re.S)) for who, log in (('host', hlog), ('guest', glog))}
    finish([host, guest], 1)
    proxy.close()
    # the new game: the same port, a match to the end
    host2, hlog2 = side(pt, d, 'host2', ['--host'] + match_args(pt, 16, 1), 1)
    code2 = pt.wait_code(hlog2, host2)
    rows = []
    if code2:
        guest2, glog2 = side(pt, d, 'guest2', ['--join', '127.0.0.1', '--code', code2] + match_args(pt, 16, 1), 1)
        finish([host2, guest2], 600)
        rows, probs = pt.compare(hlog2, glog2, 1, host2.returncode, guest2.returncode)
    else:
        finish([host2], 1)
    ok = len(lost) == 2 and max(lost.values()) <= 6.5 and all(menu.values()) and len(rows) == 1
    return ok, 'link cut: CONNECTION LOST on the host after %s s, the guest after %s s; back at the menu: host %s, guest %s; ' \
        're-hosted on UDP 27960: %d match played' % (
            '%.1f' % lost['host'] if 'host' in lost else 'never', '%.1f' % lost['guest'] if 'guest' in lost else 'never',
            'yes' if menu['host'] else 'no', 'yes' if menu['guest'] else 'no', len(rows))


def btpad(only):
    """tools/btpad's scenarios (the game's Bluetooth pad simulator, src/btpad.c): (all passed, their evidence)"""
    d = item_dir(9 if '1' in only.split(',') else 11)
    rep = os.path.join(d, 'btpad.md')
    p = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'btpad'), '--build', BUILD, '--only', only, '--report', rep],
                       capture_output=True, text=True, timeout=limit(1800))
    with open(os.path.join(d, 'btpad.log'), 'w') as f:
        f.write(p.stdout + p.stderr)
    rows = re.findall(r'^\s*(\d+) (.+?)\s+(PASS|FAIL)\s+(.*)$', p.stdout, re.M)
    ok = p.returncode == 0 and len(rows) == len(only.split(',')) and all(r[2] == 'PASS' for r in rows)
    return ok, '; '.join('%s: %s %s' % (r[1].strip(), r[2], r[3]) for r in rows) or 'no scenario ran: ' + (p.stdout + p.stderr)[-200:]


def item9():
    """A gamepad: seen when paired before the start, the menus by the pad alone, two pads each its own jet in 2P,
    and pads switched off and on again during a match (the pad simulator, as Bluetooth pads)."""
    return btpad('1,2,6,8')


def item11():
    """A gamepad lost mid-match: the match pauses, takes it back with a 3-2-1, each pad keeps its seat, in 2P a lost
    pad 2 pauses both."""
    return btpad('5,7,10')


def item28():
    """The tanker call: key 4 calls the side's tanker once; the HUD says READY, INBOUND, then ON STATION, and a
    second press does not call another."""
    fresh_cfg()
    code, log = run(['--play', '1p', '--frames', '2400', '--key', '60:4', '--key', '400:4'])
    seen = [(w, f) for w, f in states(log) if w.startswith('TANKER')]
    names = [w for w, _ in seen]
    want = ['TANKER READY', 'TANKER INBOUND', 'TANKER ON STATION']
    ok = code == 0 and names[:3] == want and names.count('TANKER INBOUND') == 1
    return ok, 'the HUD: %s; exit code %s' % (', '.join('%s at %d' % (w, f) for w, f in seen) or 'no tanker line', code)


# ---- the AI pilots' checklist (docs/AI_PILOT_CHECKLIST.md): one round's evidence, read once -------------------
ROUND = {}


def ai_round():
    """The round's runs, once: the audit with every death, the test pilots and the cheater."""
    if ROUND:
        return ROUND
    fresh_cfg()
    # the certificate's own audit (112 matches a jet, every jet and the drone, every death), one process a jet side by
    # side, so the digest compared in item 26 is of the matches its reference was taken from
    jets = ['af40', 'lf27', 'ecf90', 'ja46', 'sy26', 'vk33', 'ks55', 'nf24', 'dr7']
    logs = [os.path.join(OUT, 'audit-%s.log' % j) for j in jets]
    procs = [subprocess.Popen([EXE, '--audit', '--part', 'sorties', '--sorties', '112', '--only', j, '--out', lg],
                              env=env(TL_AUDIT_DEATHS=1), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
             for j, lg in zip(jets, logs)]
    codes = [q.wait(timeout=limit(3600)) for q in procs]
    ROUND['audit'] = ''.join(open(lg, encoding='utf-8', errors='replace').read() for lg in logs if os.path.exists(lg))
    ROUND['audit_code'] = max(codes)
    for name, args in (('pilots', ['--matches', '200', '--seed', '9']), ('cheat', ['--pilot', 'cheat', '--matches', '90', '--seed', '9'])):
        rep = os.path.join(OUT, name + '.md')
        q = subprocess.run([EXE, '--test-pilots', '--report', rep] + args, env=env(), capture_output=True, text=True, timeout=limit(1800))
        ROUND[name] = open(rep).read() if os.path.exists(rep) else ''
        ROUND[name + '_log'] = q.stdout + q.stderr
    d = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'certify'), 'digest'] + logs, capture_output=True, text=True)
    ROUND['digest'] = (d.returncode, (d.stdout + d.stderr).strip().splitlines()[-1:] or [''])
    return ROUND


def deaths(log, how=None):
    return [l for l in re.findall(r'death t=.*', log) if how is None or (': %s at' % how) in l]


def mission(report, name):
    m = re.search(r'\| %s \| (\d+) \| (\d+) \| ([^|]*)\|' % re.escape(name), report[report.find('## Over every match'):])
    return (int(m.group(1)), int(m.group(2)), m.group(3).strip()) if m else (0, 0, '')


def matches(log):
    return sum(int(n) for n in re.findall(r'(\d+) matches \(\d+ over', log))


def ai1():
    """Getting airborne: every take-off flies away; nobody crashes in the first minute."""
    r = ai_round()
    ok_, failed, note = mission(r['pilots'], 'Take-off')
    early = [l for l in deaths(r['audit'], 'CRASHED') if float(re.search(r'spawned (\d+) s', l).group(1)) < 60]
    return failed == 0 and not early, 'test pilots: %d take-offs, %d failed %s; audit: %d crashes in the first minute%s' % (
        ok_ + failed, failed, note, len(early), ' (first: %s)' % early[0][:160] if early else '')


def ai2():
    """Flying: at most one crash into the ground in 50 matches, before sudden death; no physics fault. After sudden death
    (TANKER_STAYS, 30 minutes) nobody can refuel, by the rules, so jets run dry: those are reported on their own and do
    not count against the goal ."""
    r = ai_round()
    n = max(1, matches(r['audit']))
    every = deaths(r['audit'], 'CRASHED')
    crashes = [l for l in every if int(re.search(r'death t=(\d+)', l).group(1)) < 1800]
    faults = sum(int(f) for f in re.findall(r'(\d+) faults', r['audit']))
    return len(crashes) * 50 <= n and faults == 0, '%d crashes before sudden death in %d audit matches (1 in %.0f, goal 1 in 50); %d after it, not counted; %d physics faults%s' % (
        len(crashes), n, n / max(1, len(crashes)), len(every) - len(crashes), faults, '; first crash: ' + crashes[0][:160] if crashes else '')


def ai3():
    """Fuel, landing and rearming: home in time, lands, refuels and rearms, no flameout."""
    r = ai_round()
    # dry before sudden death (TANKER_STAYS, 30 minutes): after it nobody refuels anywhere, by the rules
    dry_all = [l for l in deaths(r['audit'], 'CRASHED') if re.search(r', fuel 0 leg', l)]  # crashed for want of fuel
    dry = [l for l in dry_all if int(re.search(r'death t=(\d+)', l).group(1)) < 1800]
    land, ref, rearm = (mission(r['pilots'], m) for m in ('Landing', 'Refuel at base', 'Rearm'))
    cpu_land = [x for x in land[2].split(';') if 'CPU' in x]
    ok = not dry and ref[1] == 0 and rearm[1] == 0 and not cpu_land
    return ok, 'audit: %d jets down with an empty tank before sudden death (%d after it); test pilots: landings %d/%d (CPU failures: %d), refuels %d/%d, rearms %d/%d' % (
        len(dry), len(dry_all) - len(dry), land[0], land[0] + land[1], len(cpu_land), ref[0], ref[0] + ref[1], rearm[0], rearm[0] + rearm[1])


def ai4():
    """Fighting: every jet wins 30-70 % (the drone may win more, not every match); no friendly fire; the cheater's
    rule watch finds nothing."""
    r = ai_round()
    bad = []
    for jet, won, lost in re.findall(r'^(\w+)\s+.*?won (\d+), lost (\d+)', r['audit'], re.M):
        w, l = int(won), int(lost)
        share = w / max(1, w + l)
        if (jet != 'dr7' and not 0.3 <= share <= 0.7) or (jet == 'dr7' and l == 0):
            bad.append('%s %.0f%%' % (jet, share * 100))
    cheat = [l.strip() for l in r['cheat_log'].splitlines() if 'FINDING' in l]
    return not bad and not cheat, 'win shares outside 30-70 %%: %s; cheater findings: %s' % (', '.join(bad) or 'none',
                                                                                         '; '.join(cheat) or 'none')


def match_length(log):
    """(matches, mean minutes, share over 10 min, share over 30 min) over every aircraft's length line"""
    n = mins = o10 = o30 = 0.0
    for m in re.finditer(r'^\s+(\w+)\s+length\s+(\d+) matches: mean ([\d.]+) min, over 10 min (\d+) %, over 30 min (\d+) %', log, re.M):
        if m.group(1) == 'all':
            continue
        k = int(m.group(2))
        n, mins, o10, o30 = n + k, mins + k * float(m.group(3)), o10 + k * int(m.group(4)) / 100, o30 + k * int(m.group(5)) / 100
    return (int(n), mins / n, 100 * o10 / n, 100 * o30 / n) if n else (0, 0, 0, 0)


def ai5():
    """Matches: every match ends, every mode with every jet; a match lasts 7.30 minutes at most on average, and few reach the 30-minute sudden
    death."""
    r = ai_round()
    fails = re.findall(r'\[FAIL\] (matches.*)', r['audit'])
    timeouts = sum(int(t) for t in re.findall(r'(\d+) timeouts\)', r['audit']))
    n, mean, o10, o30 = match_length(r['audit'])
    ok = not fails and timeouts == 0 and n > 0 and mean <= 7.30 and o30 <= 5
    return ok, '%d audit matches, %d timeouts; length: mean %.1f min (target 7.30 at most), over 10 min %.0f %%, over 30 min %.0f %% (5 at most)%s' % (
        matches(r['audit']), timeouts, mean, o10, o30, '; ' + fails[0] if fails else '')


def ai6():
    """The same game everywhere: the audit's digest is the reference."""
    code, last = ai_round()['digest']
    return code == 0, 'tools/certify digest: ' + (last[0] if last else 'no output')


def ai7():
    """What the pilot sees: the instruments read the jet's own motion (the test pilots' gauge check)."""
    r = ai_round()
    rows = re.findall(r'\| (AIRSPEED KT|CLIMB FT/MIN|SLIP DEG|G|ALTITUDE FT|FUEL %) \| ([0-9.]+)% \|', r['pilots'])
    bad = [(n, v) for n, v in rows if float(v) > 3]
    return bool(rows) and not bad, 'share of the time off: ' + ', '.join('%s %s%%' % rv for rv in rows) + \
        ' (the picture check is item 6; the views stills are --audit --part views)'


