#!/usr/bin/env python3
"""tools/handson - the AI test pilots' hands-on checklist: the items a person checks by hand on each computer
(docs/TEST_GUIDE.md section 5, items 1-17), done by the game's own test hooks instead of hands, then the CPU
pilots' own checklist (docs/AI_PILOT_CHECKLIST.md sections 1-7, items 21-27) from one round of the audit, the test
pilots and the cheater. Original code for this project;
Python 3.8+ standard library only.

usage: tools/handson [--build DIR] [--report FILE] [--only N[,N...]] [--cert] [--commit SHA] [--time-scale N]

Each item drives a real copy of the game (offscreen video, so it runs without a screen): keys pressed and held
(--key), clicks (--click), window events (--event: focus, hide, show, a 2 s hitch, quit), and it reads what
happened from the game's own log (TL_STATE=1 logs every screen, sound and window change; TL_PLANES=1 where each
jet ended up; --watch the instrument and picture checks; TL_MIX_DUMP the sound mix). Every item ends PASS, FAIL
or SKIP with its evidence; the report is Markdown (--report, default build/handson/report.md). Exits 1 if an
item failed. --cert also writes certs/<commit>-hands-on-<system>.md, a box ticked only on PASS (or n/a) with its
evidence and hash, for tools/certify release. The commit comes from git, or from --commit where there is no git.

The time limits on game runs only catch a hang: a first short run measures this computer and multiplies them
(--time-scale N sets the factor instead), and the report and the list say so when the factor is not 1. On Windows,
item 1 opens a real window, so it needs a logged-in desktop; on a screen too small for a 1280x720 window it skips,
saying so.

The network items (13-15) run two copies here on UDP 27960 and 27961 (the LAN port and its beacons), so they skip
while another copy is hosting.

The settings each run uses are a copy in build/handson/cfg, never the player's own."""
import csv
import io
import os
import re
import shutil
import struct
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, 'build', 'handson')
CFG = os.path.join(OUT, 'cfg')
EXE = None
BUILD = None
TIME_SCALE = 1

# the main menu's buttons in a 1280x720 window (ui.c lays them out)
BUTTON = {'start': (640, 430), 'hangar': (491, 460), 'settings': (640, 460), 'network': (788, 460),
          'intro': (528, 490), 'exit': (752, 490)}


def fresh_cfg(extra=''):
    """A clean settings file: air start, no intro, so every run begins the same."""
    d = os.path.join(CFG, 'tailonlock')
    shutil.rmtree(CFG, ignore_errors=True)
    os.makedirs(d)
    with open(os.path.join(d, 'settings.ini'), 'w') as f:
        f.write('intro=0\nstart=air\n' + extra)


def env(**more):
    e = dict(os.environ, XDG_CONFIG_HOME=CFG, TL_CONFIG_DIR=os.path.join(CFG, 'tailonlock'), TL_VIDEO='offscreen',
             TL_AUDIO='dummy', TL_STATE='1')
    e.update({k: str(v) for k, v in more.items()})
    return e


def limit(seconds):
    """A time limit, in seconds, for this computer's speed."""
    return seconds * TIME_SCALE


def measure_time_scale():
    """How much to stretch the time limits. The intro is the slowest thing the items run: 300 frames of it in 6 s
    leaves a 3040-frame run (item 5) twice the time it needs of its 120 s."""
    fresh_cfg()
    t0 = time.monotonic()
    run(['--play', 'intro', '--frames', '300'], timeout=600)
    return max(1, min(30, int((time.monotonic() - t0) / 6) + 1))


def running_pids():
    """The ids of the running copies of the game."""
    if sys.platform == 'win32':
        out = subprocess.run(['tasklist', '/FI', 'IMAGENAME eq ' + os.path.basename(EXE), '/FO', 'CSV', '/NH'],
                             capture_output=True, text=True).stdout
        return [r[1] for r in csv.reader(io.StringIO(out)) if len(r) > 1]
    return subprocess.run(['pgrep', '-f', EXE], capture_output=True, text=True).stdout.split()


def run(args, timeout=120, **more):
    """Runs the game; returns (exit code, log text)."""
    try:
        p = subprocess.run([EXE] + args, env=env(**more), capture_output=True, text=True, timeout=limit(timeout))
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired as e:
        return 'timeout', (e.stdout or b'').decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')


def states(log):
    """The STATE lines as (what, frame)."""
    return [(m.group(1), int(m.group(2))) for m in re.finditer(r'STATE (.+?) at frame (\d+)', log)]


def first(log, what):
    for w, f in states(log):
        if w == what:
            return f
    return None


def planes(log):
    """TL_PLANES: name -> (x, y, z, speed) where each jet ended up."""
    out = {}
    for m in re.finditer(r'plane (.+?): alive \d+ taxi \d+ cat \d+ pos (\S+) (\S+) (\S+) speed (\S+)', log):
        out[m.group(1)] = tuple(float(v) for v in m.group(2, 3, 4, 5))
    return out


def cut_to_fit(state):
    """A real window smaller than the game's 1280x720: the screen is too small to show it whole."""
    m = re.fullmatch(r'window (\d+)x(\d+)', state)
    return bool(m and state != 'window 1280x720' and int(m.group(1)) <= 1280 and int(m.group(2)) <= 720)


# ---- the items -------------------------------------------------------------------------------------------------
def item1():
    """Window: the right size, fullscreen by F11 and by Alt+Enter, and back."""
    fresh_cfg()
    # Windows fullscreens only a real window (plat_fullscreen_toggle: no window, nothing to do)
    real = sys.platform == 'win32'
    code, log = run(['--frames', '400', '--key', '20:esc', '--key', '60:f11', '--key', '120:f11', '--key', '180:alt+enter',
                     '--key', '240:alt+enter'], **({'TL_VIDEO': 'real'} if real else {}))
    sizes = [w for w, _ in states(log) if w.startswith('window ')]
    turns = len(sizes) >= 5 and sizes[1] != sizes[0] and sizes[2] == sizes[0] and sizes[3] != sizes[0] and sizes[4] == sizes[0]
    seen = '%swindow sizes in turn: ' % ('a real window; ' if real else '') + ', '.join(s[7:] for s in sizes)
    if real and turns and cut_to_fit(sizes[0]):
        return None, 'screen too small for this check: ' + seen
    return turns and sizes[0] == 'window 1280x720', seen


def item2():
    """Mouse: each main-menu button does what it says where the pointer is."""
    out, ok = [], True
    for name, want in (('start', 'play'), ('hangar', 'page hangar'), ('network', 'page network')):
        fresh_cfg()
        x, y = BUTTON[name]
        code, log = run(['--frames', '200', '--click', '60:%d:%d' % (x, y)])
        hit = first(log, want)
        ok = ok and hit is not None
        out.append('%s at (%d, %d): %s' % (name, x, y, 'frame %d' % hit if hit else 'nothing'))
    fresh_cfg()
    x, y = BUTTON['exit']
    t0 = time.time()
    code, log = run(['--frames', '2000', '--click', '60:%d:%d' % (x, y)])
    quick = time.time() - t0 < 30 and 'STATE' in log and not re.search(r'frame (1[0-9]{3})', log)
    ok = ok and code == 0
    out.append('exit at (%d, %d): exit code %s' % (x, y, code))
    return ok, '; '.join(out)


def item3():
    """Keyboard: both 2-player key sets fly their jets, Esc pauses, M mutes."""
    fresh_cfg()
    out, fly = [], True
    for keys, who in ((('s', 'd'), 'PLAYER 1'), (('down', 'right'), 'PLAYER 2')):
        base = planes(run(['--play', '2p', '--seed', '3', '--frames', '240'], TL_PLANES=1)[1])
        for k in keys:
            moved = planes(run(['--play', '2p', '--seed', '3', '--frames', '240', '--key', '30:%s:150' % k], TL_PLANES=1)[1])
            mine = sum(abs(moved[who][j] - base[who][j]) for j in range(3)) if who in moved and who in base else 0
            other = [n for n in base if n != who and n in moved]
            theirs = sum(abs(moved[other[0]][j] - base[other[0]][j]) for j in range(3)) if other else 0
            fly = fly and mine > 20 and theirs < 1
            out.append('%s moved %s %.0f m (the other jet %.0f m)' % (k, who, mine, theirs))
    fresh_cfg()
    log = run(['--play', '1p', '--frames', '200', '--key', '40:m', '--key', '100:esc'])[1]
    muted = first(log, 'sound off') is not None
    paused = first(log, 'pause') is not None
    ok = fly and muted and paused
    return ok, 'keys held 2.5 s: %s; M: %s; Esc: %s' % ('; '.join(out), 'muted' if muted else 'nothing',
                                                          'paused' if paused else 'nothing')


def mix_stats(path):
    """Peak, the biggest jump between samples and the longest run of silence (s) in a float stereo 48 kHz mix."""
    data = open(path, 'rb').read()
    n = len(data) // 4
    vals = struct.unpack('<%df' % n, data[:n * 4])
    left = vals[0::2]
    peak = max((abs(v) for v in left), default=0)
    jump = max((abs(left[i] - left[i - 1]) for i in range(1, len(left))), default=0)
    run_, longest = 0, 0
    for v in left:
        run_ = run_ + 1 if abs(v) < 1e-5 else 0
        longest = max(longest, run_)
    return peak, jump, longest / 48000.0


def item4():
    """Sound: music and effects with no clicks or dropouts, and the sound back after the focus comes back."""
    fresh_cfg()
    raw = os.path.join(OUT, 'mix.raw')
    code, log = run(['--play', '1p', '--frames', '1500', '--key', '60:space:120', '--event', '700:focus-lost',
                     '--event', '760:focus-gained', '--key', '800:esc'], TL_MIX_DUMP=raw)
    if not os.path.exists(raw):
        return False, 'no mix was written'
    peak, jump, silent = mix_stats(raw)
    ok = 0 < peak <= 1.0 and jump < 0.5 and silent < 0.5
    return ok, 'peak %.2f, biggest step between samples %.3f, longest silence %.2f s (gun fired, focus lost and back)' % (
        peak, jump, silent)


def item5():
    """The intro plays to the menu by itself and can be skipped at any moment."""
    out, ok = [], True
    for f in (30, 400, 1500, 3000):
        fresh_cfg()
        code, log = run(['--play', 'intro', '--frames', str(f + 40), '--key', '%d:esc' % f])
        at = first(log, 'menu')
        ok = ok and at is not None and at <= f + 3
        out.append('Esc at %d: menu at %s' % (f, at))
    fresh_cfg()
    code, log = run(['--play', 'intro', '--frames', '5200'], timeout=600)
    at = first(log, 'menu')
    ok = ok and at is not None
    out.append('left alone: menu at %s' % at)
    return ok, '; '.join(out)


def item6():
    """Both renderers at every graphics level, with the watch's picture checks against the 3D world."""
    out, ok = [], True
    for r in ('modern', 'retro'):
        for gfx in ('low', 'medium', 'high', 'ultra'):
            fresh_cfg()
            code, log = run(['--watch', '--view', 'cockpit', '--renderer', r, '--gfx', gfx, '--frames', '900', '--seed', '5'])
            bad = [m for m in re.findall(r'(BANK DEG|PITCH DEG|ENEMY BOX PX|RANGE KM|LOCK DEG|LEAD MISS M) OFF ([0-9.]+)%', log)
                   if float(m[1]) > 2]
            ran = 'CHECK' in log and code == 0
            ok = ok and ran and not bad
            out.append('%s/%s %s' % (r, gfx, 'ok' if ran and not bad else 'FAIL ' + str(bad or code)))
    return ok, ', '.join(out)


def item7():
    """A setting survives quitting and starting again."""
    fresh_cfg()
    run(['--play', '1p', '--frames', '120', '--key', '40:m'])
    log = run(['--frames', '30'])[1]
    off = first(log, 'sound off')
    return off == 1, 'sound muted with M, then a fresh start: %s' % ('sound off from frame 1' if off == 1 else 'sound on again')


def item8():
    """Quitting by the menu's EXIT and by the window's close button: a clean exit and nothing left running."""
    out, ok = [], True
    for how, args in (('menu EXIT', ['--frames', '600', '--click', '60:%d:%d' % BUTTON['exit']]),
                      ('close button', ['--play', '1p', '--frames', '600', '--event', '120:quit'])):
        fresh_cfg()
        t0 = time.time()
        p = subprocess.Popen([EXE] + args, env=env(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        try:
            p.wait(timeout=limit(60))
        except subprocess.TimeoutExpired:
            p.kill()
        left = running_pids()
        clean = p.returncode == 0 and str(p.pid) not in left
        ok = ok and clean
        out.append('%s: exit code %s in %.1f s%s' % (how, p.returncode, time.time() - t0, '' if clean else ', STILL RUNNING'))
    return ok, '; '.join(out)


def skip(why):
    return lambda: (None, why)


def item12():
    """Minimised (or asleep) mid-match: the match pauses, a 2 s hitch does not hang it, and it carries on."""
    fresh_cfg()
    raw = os.path.join(OUT, 'mix12.raw')
    code, log = run(['--play', '1p', '--frames', '900', '--event', '200:hide', '--event', '230:stall', '--event', '260:show',
                     '--key', '300:esc'], TL_MIX_DUMP=raw)
    paused = first(log, 'pause')
    back = [f for w, f in states(log) if w == 'play' and f > 260]
    peak = mix_stats(raw)[0] if os.path.exists(raw) else 0
    ok = code == 0 and paused is not None and bool(back) and peak > 0
    return ok, 'hidden at 200: paused at %s; shown, Esc at 300: playing at %s; exit code %s; sound peak %.2f' % (
        paused, back[0] if back else None, code, peak)


def item16():
    """Killed mid-match: the settings file is intact and read at the next start."""
    fresh_cfg('sound=0\n')
    p = subprocess.Popen([EXE, '--play', '1p', '--frames', '100000'], env=env(), stdout=subprocess.DEVNULL,
