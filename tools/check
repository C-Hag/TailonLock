FLOPPY = 1474560  # bytes on a 1.44 MB floppy
FLOPPY_HARD = False  # True once the F track is done: then a build over the budget fails
# what the game reads at run time; the recorded music (*.wav) is an extra, not on the floppy
FLOPPY_GAME = ['assets/intro/*.json', 'assets/jets/*.glb', 'assets/jets/*_game.js', 'assets/jets/*.json',
               'assets/maps/*.json', 'assets/maps/*.h16', 'assets/maps/*.mat', 'assets/music/*.json',
               'assets/music/*.loop']
FLOPPY_WEB = ['web/index.html', 'web/sfx/*.wav']


def packed_size(files):
    """the files in one tar, xz-compressed at its strongest setting: (bytes, the 6 biggest files raw)"""
    import io
    import lzma
    import tarfile
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode='w') as tar:
        for name, path in files:
            tar.add(path, arcname=name)
    xz = lzma.compress(buf.getvalue(), preset=9 | lzma.PRESET_EXTREME)
    big = sorted(((os.path.getsize(p), n) for n, p in files), reverse=True)[:6]
    return len(xz), big


def stage_floppy():
    import glob
    exe = os.path.join(bdir('gcc-release'), 'tailonlock')
    if not os.path.exists(exe):
        say('    no release build to measure')
        return False
    tmp = tempfile.mkdtemp(prefix='tl-floppy-')
    try:
        game = os.path.join(tmp, 'tailonlock')
        shutil.copy(exe, game)
        rc, out = run(['strip', game])
        if rc:
            say('    strip failed: ' + out.strip()[:200])
            return False
        ok = True
        for title, pats, extra in (('game', FLOPPY_GAME, [('tailonlock', game)]), ('web', FLOPPY_WEB, [])):
            files = list(extra)
            for pat in pats:
                for p in sorted(glob.glob(os.path.join(ROOT, pat))):
                    files.append((os.path.relpath(p, ROOT), p))
            n, big = packed_size(files)
            over = n > FLOPPY
            ok = ok and not over
            say('    %-4s %4d files, %7.0f KB packed of %4.0f KB: %s' % (
                title, len(files), n / 1024, FLOPPY / 1024,
                '%.0f KB over' % ((n - FLOPPY) / 1024) if over else '%.0f KB free' % ((FLOPPY - n) / 1024)))
            say('         biggest: ' + ', '.join('%s %.0f KB' % (nm, b / 1024) for b, nm in big))
        if not ok and not FLOPPY_HARD:
            say('    (a report for now: the F track brings it under; see docs/BUILD_PLAN.md)')
        return ok or not FLOPPY_HARD
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ---------------------------------------------------------------------------------------------------------
def main():
    args = sys.argv[1:]
    quick, baseline, serial = '--quick' in args, '--baseline' in args, '--serial' in args
    only = None
    if '--only' in args:
        only = {int(x) for x in args[args.index('--only') + 1].split(',')}
    stages = [(1, 'build', stage_build), (2, 'tests', stage_tests), (3, 'golden', lambda: stage_golden(baseline)),
              (4, 'deps', stage_deps), (5, 'cleanroom', stage_cleanroom), (6, 'headless', stage_headless),
              (7, 'picture', lambda: stage_picture(baseline)), (8, 'sound', lambda: stage_sound(baseline, '--new-sound' in args)),
              (9, 'perf', lambda: stage_perf(baseline)), (10, 'windows', stage_windows),
              (11, 'floppy', stage_floppy)]
    if quick:
        stages = stages[:4]
    if only:
        stages = [s for s in stages if s[0] in only]
    os.makedirs(os.path.join(OUT, 'logs'), exist_ok=True)
    rc, head = run(['git', 'rev-parse', '--short', 'HEAD'])
    rc, dirty = run(['git', 'status', '--porcelain', '--untracked-files=no'])
    commit = head.strip() + ('-dirty' if dirty.strip() else '')
    rc, branch = run(['git', 'rev-parse', '--abbrev-ref', 'HEAD'])
    t0 = datetime.datetime.now()
    say('tools/check %s  commit %s on %s  %s' % (' '.join(args), commit, branch.strip(), t0.strftime('%Y-%m-%d %H:%M')))
    results = {}

    def one(n, name, fn, buffered):
        if buffered:
            _tls.buf = []
        s0 = time.time()
        try:
            ok = bool(fn())
        except Exception as x:  # a broken stage is a failed stage
            say('    crashed: %r' % x)
            ok = False
        lines = getattr(_tls, 'buf', None) or []
        _tls.buf = None
        return ok, lines, time.time() - s0

    def show(n, name, res):
        ok, lines, secs = res
        say('[%2d] %s' % (n, name))
        for l in lines:
            say(l)
        say('[%2d] %-10s %s  (%.0f s)' % (n, name, 'PASS' if ok else 'FAIL', secs))
        results[n] = (n, name, ok)

    first = [s_ for s_ in stages if s_[0] == 1]
    alone = [s_ for s_ in stages if s_[0] == 9]
    rest = [s_ for s_ in stages if s_[0] not in (1, 9)]
    for n, name, fn in first:
        say('[%2d] %s' % (n, name))
        ok, _, secs = one(n, name, fn, False)
        say('[%2d] %-10s %s  (%.0f s)' % (n, name, 'PASS' if ok else 'FAIL', secs))
        results[n] = (n, name, ok)
    if serial:
        for n, name, fn in rest:
            show(n, name, one(n, name, fn, True))
    elif rest:
        say('(stages %s side by side)' % ', '.join(str(x[0]) for x in rest))
        with ThreadPoolExecutor(len(rest)) as ex:
            futs = [(n, name, ex.submit(one, n, name, fn, True)) for n, name, fn in rest]
            for n, name, f in futs:
                show(n, name, f.result())
    for n, name, fn in alone:
        show(n, name, one(n, name, fn, True))
    results = [results[k] for k in sorted(results)]
    say()
    for n, name, ok in results:
        say('  %2d %-10s %s' % (n, name, 'PASS' if ok else 'FAIL'))
    failed = [r for r in results if not r[2]]
    partial = quick or only
    say('%s%s  (%.0f s)' % ('PASS' if not failed else 'FAIL', ' (partial run)' if partial else '',
                            (datetime.datetime.now() - t0).total_seconds()))
    rp = os.path.join(OUT, '%s-%s.txt' % (t0.strftime('%Y-%m-%d'), commit))
    open(rp, 'w').write('\n'.join(report) + '\n')
    print('report: ' + os.path.relpath(rp, ROOT))
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
