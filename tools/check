def gpu_present():
    """True when the game's own GPU renderer starts headless here (the driver's offscreen context)"""
    global _gpu
    if _gpu is None:
        exe = os.path.join(bdir('gcc-release'), 'tailonlock')
        tmp = tempfile.mkdtemp(prefix='check-cfg-')
