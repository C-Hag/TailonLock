def stage_sound(baseline, new_sound=False):
    """the render against its reference in sound.sha256: one line for every system (the synth and the effects use
    core/fmath, and the notes are sorted into a total order, so every C library gives the same bits); a machine-own
    line (taken with --baseline or --new-sound from a render that passes the ear check) is still read if there
    is no common one"""
    import platform
    key, secs = THEME
    exe = os.path.join(bdir('gcc-release'), 'tailonlock')
    cmp_exe = os.path.join(bdir('gcc-release'), 'check_cmp')
    ear = os.path.join(bdir('gcc-release'), 'ear_check')
    machine = '%s-%s' % (sys.platform, platform.machine())
    os.makedirs(REF, exist_ok=True)
    cur = os.path.join(OUT, 'logs', key + '-render.wav')
    tmp = tempfile.mkdtemp(prefix='check-cfg-')
    env = game_env(tmp)
    env['TL_MUSIC_LOOP'] = str(secs)
    rc, out = run([exe, '--render-music', key, cur], env=env, timeout=900)
    shutil.rmtree(tmp, ignore_errors=True)
    if rc or not os.path.exists(cur):
        say('    render failed')
        return False
    rc, rep = run([ear, cur])
    g = lambda pat: re.search(pat, rep, re.M)
    tp, lufs, verdict = g(r'true peak ([-+0-9.]+) dBTP'), g(r'integrated ([-+0-9.]+) LUFS'), g(r'^verdict: (\w+)')
    bad = [l.strip() for l in rep.splitlines() if re.match(r'\s+(WARN|HURT)|.*(click|sudden jump)', l)]
    if not (tp and lufs and verdict):
        say('    ear check failed: ' + rep.strip()[-300:])
        return False
    ear_ok = verdict.group(1) in ('OK', 'NOTE') and not bad and float(tp.group(1)) <= -1 and abs(float(lufs.group(1)) + 20) <= 1
    say('    ear check (%d s through the loop): %s, %s LUFS, true peak %s dBTP%s' % (
        secs, verdict.group(1), lufs.group(1), tp.group(1), ('; ' + '; '.join(bad)) if bad else ''))
    ref = os.path.join(REF, '%s-render-%s.wav' % (key, machine))
    hashp = os.path.join(GOLD, 'sound.sha256')
    lines = [l for l in open(hashp).read().splitlines() if l.strip()] if os.path.exists(hashp) else []
    label = '%s-render.wav (%d s through the player) on %s' % (key, secs, machine)
    # one line for every system (the sound uses core/fmath and a total note order), else this machine's own
    every = '%s-render.wav (%d s through the player) on every system' % (key, secs)
    want = next((l.split()[0] for l in lines if l.split('  ', 1)[-1] == every), None)
    if want is None:
        want = next((l.split()[0] for l in lines if l.endswith(' on ' + machine)), None)
    if baseline or new_sound or want is None:
        if not ear_ok:
            say('    no reference render taken: the render does not pass the ear check')
            return False
        shutil.copy(cur, ref)
        lines = [l for l in lines if not l.endswith(' on ' + machine)] + ['%s  %s' % (sha(ref), label)]
        open(hashp, 'w').write('\n'.join(sorted(lines, key=lambda l: l.split('  ', 1)[1])) + '\n')
        say('    reference render taken for %s (%d s)' % (machine, secs))
        return True
    if sha(cur) == want:
        say('    render identical to the reference render (%s)' % machine)
        return ear_ok
    if os.path.exists(ref) and sha(ref) == want:
        rc, out = run([cmp_exe, 'wav', ref, cur])
        m = re.search(r'maxdiff (\d+)', out)
        d = int(m.group(1)) if m else 99999
        say('    render vs the reference render: %s LSB at most (limit 2)' % (m.group(1) if m else out.strip()))
        return ear_ok and rc == 0 and d <= 2
    say('    render differs from the reference hash for %s, and the reference render is not on this machine' % machine)
    return False


