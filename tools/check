def private_terms():
    p = os.environ.get('TL_CHECK_PRIVATE') or os.path.join(ROOT, '.check-private')
    rules = {'personal': [], 'original': [], 'homage': []}
    if not os.path.exists(p):
        return None
    for line in open(p, encoding='utf-8'):
        line = line.rstrip('\n')
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        kind, _, rest = line.partition(' ')
        if kind in rules and rest:
            rules[kind].append(rest)
    return rules


