def asan_run(args):
    exe = os.path.join(bdir('clang-asan'), 'tailonlock')
    tmp = tempfile.mkdtemp(prefix='check-cfg-')
    env = game_env(tmp)
    env.update({'ASAN_OPTIONS': 'detect_leaks=1:halt_on_error=1:abort_on_error=0',
                'UBSAN_OPTIONS': 'halt_on_error=1:print_stacktrace=1',
                'LSAN_OPTIONS': 'suppressions=' + os.path.join(GOLD, 'lsan-system.supp'),
                'ASAN_SYMBOLIZER_PATH': shutil.which('llvm-symbolizer') or shutil.which('addr2line') or ''})
    rc, out = run([exe, '--renderer', 'retro'] + args, env=env, timeout=1800)
    shutil.rmtree(tmp, ignore_errors=True)
    errs = [l for l in out.splitlines() if re.search(r'ERROR: (Address|Leak)Sanitizer|runtime error:|SUMMARY:', l)]
    m = re.search(r'ran (\d+) frames', out)
    return rc, errs, m.group(1) if m else '?', out


def stage_headless():
    jobs = {'intro': ['--play', 'intro', '--frames', '900']}
