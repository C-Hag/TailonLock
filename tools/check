    else:
        say('    no GPU here: the software set only')
    jobs = [(st, gpu, n, a) for st, gpu in sets for n, a in SHOTS.items()]
    with ThreadPoolExecutor(len(jobs)) as ex:  # one batch: the GPU and software shots side by side
        made = {(st, n): ex.submit(shot, a, os.path.join(work, '%s-%s.bmp' % (st, n)), gpu) for st, gpu, n, a in jobs}
        made = {k: f.result() for k, f in made.items()}
    for st, gpu, n, a in jobs:
        cur = os.path.join(work, '%s-%s.bmp' % (st, n))
        refgz = os.path.join(GOLD, 'pictures', st, n + '.bmp.gz')
