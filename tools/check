def say(s=''):
    """a report line: printed at once when one stage runs, kept in the stage's own buffer when several do"""
    buf = getattr(_tls, 'buf', None)
    if buf is None:
        print(s, flush=True)
        report.append(s)
    else:
        buf.append(s)


def run(cmd, env=None, cwd=None, timeout=3600):
    e = dict(os.environ)
    e.update(env or {})
    try:
        p = subprocess.run(cmd, cwd=cwd or ROOT, env=e, capture_output=True, text=True, timeout=timeout,
                           errors='replace')
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired as x:
        out = (x.stdout or b'') + (x.stderr or b'')
        return 124, out.decode(errors='replace') if isinstance(out, bytes) else out
    except FileNotFoundError as x:
        return 127, str(x)


def bdir(name):
    return os.path.join(OUT, name)


def game_env(tmp, gpu=False):
    """a scratch settings folder, no display, no sound card (the platform layer's offscreen window: the GPU
    renderer draws into a picture in memory, the software one keeps its framebuffer)"""
    return {'XDG_CONFIG_HOME': tmp, 'HOME': tmp, 'TL_VIDEO': 'offscreen', 'TL_AUDIO': 'dummy'}


def sha(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for c in iter(lambda: f.read(1 << 20), b''):
            h.update(c)
    return h.hexdigest()


def tracked(*patterns):
    # new files not yet added count too (not the ignored ones), so a gate run before `git add` sees them
    rc, out = run(['git', 'ls-files', '--cached', '--others', '--exclude-standard', '--'] + list(patterns))
    return [l for l in out.splitlines() if l]


# ---- 1 build ---------------------------------------------------------------------------------------------
def fetched_sources():
    """-D options for sources CMake fetches: none any more (brick 20)"""
    return []


def build_one(name, conf, toolchain=None):
    d = bdir(name)
    logp = os.path.join(OUT, 'logs', name + '.log')
    # Ninja where it is installed, else make (as tools/certify does): a machine without Ninja still runs the gate
    gen = 'Ninja' if shutil.which('ninja') else 'Unix Makefiles'
    if not os.path.exists(os.path.join(d, 'build.ninja' if gen == 'Ninja' else 'Makefile')):
        cmd = ['cmake', '-S', ROOT, '-B', d, '-G', gen, '-DCMAKE_BUILD_TYPE=' + conf['type'], '-DTL_WERROR=ON']
        if toolchain:
            cmd.append('-DCMAKE_TOOLCHAIN_FILE=' + toolchain)
        else:
            cmd += ['-DCMAKE_C_COMPILER=' + conf['cc'], '-DTL_SANITIZE=' + ('ON' if conf['san'] else 'OFF')]
        cmd += fetched_sources()
        rc, out = run(cmd)
        open(logp, 'w').write(out)
        if rc:
            return False, 'configure failed (%s)' % os.path.relpath(logp, ROOT)
    rc, out = run(['cmake', '--build', d, '-j', JOBS])
    open(logp, 'a').write(out)
    if rc and re.search(r'cannot find \S*lib(asan|ubsan)', out):
        return False, 'GCC sanitizer runtimes missing: sudo dnf install -y libasan libubsan'
    if rc:
        errs = [l for l in out.splitlines() if re.search(r'error:|warning:', l)][:6]
        return False, 'build failed: ' + ' | '.join(errs)
    warns = [l for l in out.splitlines() if re.search(r'(?<!-W)\bwarning:', l) and '/_deps/' not in l]
    if warns:
        return False, 'warnings: ' + ' | '.join(warns[:4])
    return True, 'ok'


def stage_build():
    os.makedirs(os.path.join(OUT, 'logs'), exist_ok=True)
    ok_all = True
    first = 'gcc-release'
    ok, msg = build_one(first, BUILDS[first])  # first, so it fetches the sources once
    say('    %-14s %s' % (first, msg))
    ok_all &= ok
    with ThreadPoolExecutor(3) as ex:
        res = {n: ex.submit(build_one, n, c) for n, c in BUILDS.items() if n != first}
        for n, f in res.items():
            ok, msg = f.result()
            say('    %-14s %s' % (n, msg))
            ok_all &= ok
    return ok_all


# ---- 2 tests ---------------------------------------------------------------------------------------------
def stage_tests():
    ok_all = True
    for name in ('gcc-release', 'clang-asan'):
        tmp = tempfile.mkdtemp(prefix='check-cfg-')
        env = {'XDG_CONFIG_HOME': tmp, 'HOME': tmp, 'ASAN_OPTIONS': 'detect_leaks=1',
               'UBSAN_OPTIONS': 'halt_on_error=1:print_stacktrace=1'}
        rc, out = run(['ctest', '--test-dir', bdir(name), '--output-on-failure', '-j', '4'], env=env)
        shutil.rmtree(tmp, ignore_errors=True)
        m = re.search(r'(\d+)% tests passed, (\d+) tests failed out of (\d+)', out)
        summary = m.group(0) if m else 'no ctest summary'
        bad = rc != 0 or 'runtime error:' in out or not m or m.group(2) != '0'
        say('    %-14s %s' % (name, summary))
        if bad:
            for l in [l for l in out.splitlines() if 'Failed' in l or 'runtime error' in l or 'ERROR' in l][:8]:
                say('      ' + l)
        ok_all &= not bad
    return ok_all


# ---- 3 golden data ---------------------------------------------------------------------------------------
def json_inputs():
    """every tracked JSON file, plus the two tables the game reads out of .js files"""
    items = [(p, None) for p in tracked('*.json')]
    items += [('assets/jets/jets_game.js', ('[', ']')), ('assets/jets/carrier_game.js', ('{', '}'))]
    return items


def stage_golden(baseline):
    dumper = os.path.join(bdir('gcc-release'), 'json_dump')
    manifest_p = os.path.join(GOLD, 'json.sha256')
    manifest = {}
    if os.path.exists(manifest_p):
        for l in open(manifest_p):
            h, p = l.rstrip('\n').split('  ', 1)
            manifest[p] = h
    new = {}
    ok_all = True
    bad = []
    for path, table in json_inputs():
        rc, out = run([dumper, path] + list(table or ()))
        if rc != 0:
            bad.append('%s: dumper failed' % path)
            ok_all = False
            continue
        key = path + (' %s%s' % table if table else '')
        data = out.encode()
        new[key] = hashlib.sha256(data).hexdigest()
        refp = os.path.join(REF, 'json', path.replace('/', '__') + '.txt')
        if baseline:
            os.makedirs(os.path.dirname(refp), exist_ok=True)
            open(refp, 'wb').write(data)
            continue
        if manifest.get(key) != new[key]:
            ok_all = False
            why = 'not in the manifest' if key not in manifest else 'differs'
            if os.path.exists(refp):
                old = open(refp, 'rb').read().decode().splitlines()
                cur = out.splitlines()
                at = next((i for i, (a, b) in enumerate(zip(old, cur)) if a != b), min(len(old), len(cur)))
                why += ' from line %d: %r -> %r' % (at + 1, old[at] if at < len(old) else '<end>',
                                                    cur[at] if at < len(cur) else '<end>')
            bad.append('%s: %s' % (key, why))
    if baseline:
        os.makedirs(GOLD, exist_ok=True)
        with open(manifest_p, 'w') as f:
            for k in sorted(new):
                f.write('%s  %s\n' % (new[k], k))
    gone = sorted(set(manifest) - set(new)) if not baseline else []
    for g in gone:
        bad.append('%s: in the manifest, no longer dumped' % g)
        ok_all = False
    invalid = [k for k in new if hashlib.sha256(b'invalid\n').hexdigest() == new[k]]
    say('    %d JSON inputs dumped, %d identical to the references%s' %
        (len(new), len(new) - len(bad) if not baseline else len(new), ' (baseline taken)' if baseline else ''))
    if invalid:
        say('    unparsable: ' + ', '.join(invalid))
        ok_all = False
    # the meshes (brick 7): today's source meshes as canonical dumps, and the same meshes through our own .glb
    # writer and reader; both must match the reference hashes
    ok_all &= golden_meshes(baseline, bad)
    glb = tracked('*.glb', '*.gltf')
    say('    %d .glb/.gltf files tracked' % len(glb))
    for b in bad[:10]:
        say('      ' + b)
    # the opening film's framing: every shot keeps its subjects in the letterboxed frame (assets/intro/tools)
    rc, out = run(['node', os.path.join(ROOT, 'assets', 'intro', 'tools', 'frame_check.js'), '--strict'])
    lines = [l for l in out.splitlines() if 'OUT from' in l or 'leave the frame' in l]
    say('    intro framing: %s' % ('every shot keeps its subjects in frame' if rc == 0 else 'subjects leave the frame'))
    for l in lines[:6]:
        say('      ' + l.strip()[:150])
    ok_all = ok_all and rc == 0
    # the figure engine: the C game's and the browser game's make the same triangles (assets/figure/parity.js)
    rc, out = run(['node', os.path.join(ROOT, 'assets', 'figure', 'parity.js'), os.path.join(bdir('gcc-release'), 'test_figure')])
    say('    figure engine, C against the browser game: %s' % ('the same triangles for every crew pose' if rc == 0 else 'DIFFERENT'))
    rc2, out2 = run([sys.executable, os.path.join(ROOT, 'tools', 'sync_figure.py'), '--check'])
    say('    ' + out2.strip())
    ok_all = ok_all and rc2 == 0
    for l in out.splitlines():
        if rc and l.strip():
            say('      ' + l.strip()[:150])
    ok_all = ok_all and rc == 0
    return ok_all


def golden_meshes(baseline, bad):
    rel = bdir('gcc-release')
    exe, dumper = os.path.join(rel, 'tailonlock'), os.path.join(rel, 'glb_dump')
    work = tempfile.mkdtemp(prefix='check-meshes-')
    src, glbd = os.path.join(work, 'src'), os.path.join(work, 'glb')
    os.makedirs(src)
    os.makedirs(glbd)
    env = game_env(work)
    r1, o1 = run([exe, '--dump-meshes', src], env=env, timeout=300)
    r2, o2 = run([exe, '--export-glb', glbd], env=env, timeout=300)
    if r1 or r2:
        bad.append('meshes: the game could not dump or export them')
        shutil.rmtree(work, ignore_errors=True)
        return False
    manifest_p = os.path.join(GOLD, 'meshes.sha256')
    manifest = {}
    if os.path.exists(manifest_p):
        for l in open(manifest_p):
            h, p = l.rstrip('\n').split('  ', 1)
            manifest[p] = h
    ids = sorted(f[:-4] for f in os.listdir(src) if f.endswith('.txt'))
    new, same_src, same_glb = {}, 0, 0
    for i in ids:
        d = open(os.path.join(src, i + '.txt'), 'rb').read()
        new[i] = hashlib.sha256(d).hexdigest()
        rc, out = run([dumper, os.path.join(glbd, i + '.glb')])
        rt = out.encode()
        if baseline:
            continue
        if manifest.get(i) == new[i]:
            same_src += 1
        else:
            bad.append('mesh %s: the source mesh differs from its reference' % i)
        if rc == 0 and hashlib.sha256(rt).hexdigest() == manifest.get(i):
            same_glb += 1
        else:
            bad.append('mesh %s: through our .glb it differs from its reference' % i)
    # the .glb files the game loads (brick 8): each must hold its reference mesh exactly
    shipped, same_shipped = 0, 0
    if not baseline:
        for p in tracked('assets/jets/*.glb'):
            i = os.path.basename(p)[:-4]
            shipped += 1
            rc, out = run([dumper, os.path.join(ROOT, p)])
            if rc == 0 and hashlib.sha256(out.encode()).hexdigest() == manifest.get(i):
                same_shipped += 1
            else:
                bad.append('%s: not the reference mesh (re-export with --export-glb assets/jets)' % p)
    shutil.rmtree(work, ignore_errors=True)
    if baseline:
        with open(manifest_p, 'w') as f:
            for k in sorted(new):
                f.write('%s  %s\n' % (new[k], k))
        say('    %d meshes: references taken' % len(ids))
        return True
    gone = sorted(set(manifest) - set(new))
    for g in gone:
        bad.append('mesh %s: in the manifest, no longer exported' % g)
    say('    %d meshes: %d sources and %d .glb round trips identical to the references' % (len(ids), same_src, same_glb))
    say('    the game loads %d .glb meshes, %d identical to the references' % (shipped, same_shipped))
    return bool(ids) and same_src == same_glb == len(ids) == len(manifest) and same_shipped == shipped


# ---- 4 dependencies --------------------------------------------------------------------------------------
def allowed_lib(soname):
    return any(re.search(p, soname) for p in LINUX_OK)


def stage_deps():
    ok_all = True
    rel = bdir('gcc-release')
    # what the binaries link
    for exe in ('tailonlock', 'test_core', 'tl_relay', 'json_dump', 'check_cmp'):
        p = os.path.join(rel, exe)
        if not os.path.exists(p):
            continue
        rc, out = run(['ldd', p])
        libs = [l.split()[0] for l in out.splitlines() if l.strip() and not l.strip().startswith('statically')]
        bad = [l for l in libs if not allowed_lib(os.path.basename(l))]
        say('    %-11s links %s%s' % (exe, ', '.join(os.path.basename(l) for l in libs) or '(nothing)',
                                     ('   NOT ALLOWED: ' + ', '.join(bad)) if bad else ''))
        ok_all &= not bad
    # what it may load at run time (library names in the binary, for dlopen)
    data = open(os.path.join(rel, 'tailonlock'), 'rb').read()
    names = sorted(set(m.decode() for m in re.findall(rb'lib[A-Za-z0-9_+-]+\.so(?:\.[0-9]+)*', data)))
    extra = [n for n in names if not allowed_lib(n)]
    if extra:
        say('    loads at run time, NOT ALLOWED: ' + ', '.join(extra))
        ok_all = False
    # what CMake fetches, finds or vendors
    cm = ''.join(open(os.path.join(ROOT, p)).read() for p in tracked('CMakeLists.txt', '*.cmake', '*/CMakeLists.txt'))
    fetched = re.findall(r'FetchContent_Declare\(\s*(\w+)', cm) + re.findall(r'find_package\(\s*(\w+)', cm)
    listed = {c for e in ALLOW.values() for c in e['cmake']}
    for f in fetched:
        if f not in listed:
            say('    CMake fetches or finds %s: NOT ALLOWED' % f)
            ok_all = False
    vendored = sorted({p.split('/')[1] for p in tracked('third_party/*') if p.count('/') >= 2})
    for v in vendored:
        if not any(e['dir'] == 'third_party/' + v for e in ALLOW.values()):
            say('    third_party/%s is vendored: NOT ALLOWED' % v)
            ok_all = False
    # what the sources include
    inc_bad = []
    srcs = tracked('src/*.c', 'src/*.h', 'relay/*.c', 'relay/*.h', 'tests/*.c', 'tests/*.h')
    for p in srcs:
        for i, line in enumerate(open(os.path.join(ROOT, p), errors='replace'), 1):
            m = re.match(r'\s*#\s*include\s*([<"])([^>"]+)[>"]', line)
            if not m:
                continue
            h = m.group(2)
            if m.group(1) == '"' and any(os.path.exists(os.path.join(ROOT, d, h))
                                         for d in ('src', os.path.dirname(p))):
                continue
            if re.search(SYSTEM_HEADERS, h) or any(re.search(r, h) for e in ALLOW.values() for r in e['include']):
                continue
            inc_bad.append('%s:%d %s' % (p, i, h))
    for b in inc_bad[:10]:
        say('    include NOT ALLOWED: ' + b)
    ok_all &= not inc_bad
    say('    allow-list: ' + ', '.join('%s (until brick %d)' % (k, v['brick']) for k, v in ALLOW.items()))
    return ok_all


# ---- 5 clean room ----------------------------------------------------------------------------------------
def grep(pattern, exclude=()):
    """[(path, line number, line)] for tracked text files, outside the excluded paths"""
    spec = ['--', '.'] + [':!' + e for e in exclude]
    rc, out = run(['git', 'grep', '--untracked', '-n', '-I', '-P', pattern] + spec)
    hits = []
    for l in out.splitlines():
        m = re.match(r'([^:]+):(\d+):(.*)', l)
        if m:
            hits.append((m.group(1), int(m.group(2)), m.group(3)))
    return hits


def in_blob(line, pattern):
    """every match sits inside a long base64 run (embedded binary data, not words)"""
    # git grep -P takes an inline (?i) anywhere, Python only at the start: drop them and match without case
    ms = list(re.finditer(pattern.replace('(?i)', ''), line, re.I))
    blobs = [(m.start(), m.end()) for m in re.finditer(r'[A-Za-z0-9+/=]{60,}', line)]
    return ms and all(any(a <= m.start() and m.end() <= b for a, b in blobs) for m in ms)


def stage_cleanroom():
    ok_all = True
    vendored = [e['dir'] for e in ALLOW.values() if e['dir']]
    # other projects' names: the allow-listed ones may appear while listed, the rest never
    hits = grep('|'.join(FOREIGN), exclude=vendored + ['docs/BUILD_PLAN.md', 'tools/check'])
    say('    foreign names (never allowed): %d hits' % len(hits))
    for p, n, l in hits[:8]:
        say('      %s:%d %s' % (p, n, l.strip()[:120]))
    ok_all &= not hits
    for k, e in ALLOW.items():
        hits = grep('|'.join(e['names']), exclude=vendored + NAMES_DOCS)
        files = sorted({p for p, _, _ in hits})
        say('    %s names: %d lines in %d files (allow-listed until brick %d)' % (k, len(hits), len(files), e['brick']))
        # since brick 9 the game reaches it only through the platform backend and the GPU renderer
        inside = e.get('inside')
        if inside:
            out = sorted({p for p, _, _ in hits if p.startswith('src/') and p not in inside})
            say('    %s names in src/ outside %s: %d files%s' % (k, ', '.join(inside), len(out),
                                                            ('   ' + ', '.join(out[:6])) if out else ''))
            ok_all &= not out
    # licence headers outside the vendored code
    hits = grep(LICENCE, exclude=vendored + ['tools/check'])
    say('    licence headers outside third_party/: %d' % len(hits))
    for p, n, l in hits[:8]:
        say('      %s:%d %s' % (p, n, l.strip()[:120]))
    ok_all &= not hits
    # files that must never be in the repository: SID tunes and their editor files, C64 images, fonts, and the
    # private .m4a recordings (they stay off the repository)
    bad = [p for p in tracked() if re.search(FORBIDDEN_FILES, p)]
    say('    forbidden file types (.sid .sf2 .prg .d64 .crt, fonts, .m4a recordings): %d' % len(bad))
    for p in bad[:8]:
        say('      ' + p)
    ok_all &= not bad
    # personal and machine terms: the generic ones here, his own from the private list
    priv = private_terms()
    pats = [PERSONAL_GENERIC] + (priv['personal'] if priv else [])
    pat = '|'.join('(?:%s)' % x for x in pats)
    hits = [h for h in grep(pat, exclude=['tools/check']) if not in_blob(h[2], pat)]
    say('    personal or machine terms (%s): %d' % ('generic and %d private' % len(priv['personal']) if priv else
                                                    'generic only: no private term list', len(hits)))
    for p, n, l in hits[:8]:
        say('      %s:%d %s' % (p, n, l.strip()[:120]))
    ok_all &= not hits
    # the original game and other works: none at all (the README is the game's own, with no homage line)
    if priv and priv['original']:
        pat = '|'.join('(?:%s)' % x for x in priv['original'])
        hits = grep(pat, exclude=vendored + ['tools/check'])
        other = [h for h in hits if not (h[0] == 'README.md' and h[2].strip() in priv['homage'])]
        homage = len(hits) - len(other)
        say('    the original game and other works: %d homage line%s, %d other hits' %
            (homage, '' if homage == 1 else 's', len(other)))
        for p, n, l in other[:8]:
            say('      %s:%d %s' % (p, n, l.strip()[:120]))
        ok_all &= homage == 0 and not other
    else:
        say('    the original game and other works: skipped (no private term list)')
    return ok_all


