def frame_ms(extra, gpu):
    """(ms per frame drawn, ms per frame in all) for one fixed run"""
    exe = os.path.join(bdir('gcc-release'), 'tailonlock')
    tmp = tempfile.mkdtemp(prefix='check-cfg-')
    rc, out = run([exe, '--renderer', 'modern' if gpu else 'retro'] + PERF + extra, env=game_env(tmp, gpu=gpu),
                  timeout=900)
    shutil.rmtree(tmp, ignore_errors=True)
    m = re.search(r'([0-9.]+) ms per frame drawn, ([0-9.]+) ms per frame in all', out)
    return (float(m.group(1)), float(m.group(2))) if m else None


def stage_perf(baseline):
    """runs alone, after the others: timings with nothing else on the machine"""
    scenes = [('soft', False, 0)]  # (name, GPU, which number: 0 drawn, 1 in all)
    if gpu_present():
        scenes.append(('gpu', True, 1))
    p = os.path.join(GOLD, 'perf.txt')
    base = {}
    if os.path.exists(p):
        for l in open(p):
            f = l.split()
            if len(f) > 1 and not l.startswith('#'):
                base[f[0]] = float(f[1])
    ok_all = True
    lines = []
    for name, gpu, k in scenes:
        runs = [frame_ms([], gpu) for _ in range(3)]
        if None in runs:
            say('    %s: the flight scene did not report its frame time' % name)
            ok_all = False
            continue
        best = min(r[k] for r in runs)
        what = 'ms per frame drawn' if k == 0 else 'ms per frame in all'
        lines.append('%s %.3f %s, best of 3: %s renderer, %s' % (name, best, what, 'modern' if gpu else 'retro',
                                                                  ' '.join(PERF)))
        if baseline:
            say('    %-4s baseline %.3f %s' % (name, best, what))
        elif name not in base:
            say('    %-4s no baseline' % name)
            ok_all = False
        else:
            good = best <= base[name] * 1.05
            say('    %-4s %.3f %s against the baseline %.3f (%+.1f %%, limit +5 %%)' %
                (name, best, what, base[name], 100 * (best / base[name] - 1)))
            ok_all &= good
    if baseline:
        open(p, 'w').write('# tools/check stage 9 baselines, this machine (retake only in brick 0)\n' + '\n'.join(lines) + '\n')
    if gpu_present():  # the table: every map at every time of day on the GPU (logged, not gated)
        say('    GPU frame time per map and time of day (ms per frame in all / fps):')
        say('      %-12s %s' % ('', ''.join('%15s' % t for t in TODS)))
        for mp in MAPS:
            row = []
            for t in TODS:
                r = frame_ms(['--map', mp, '--time', t], True)
                row.append('%8.3f %5.0f' % (r[1], 1000 / r[1]) if r else '%15s' % 'failed')
            say('      %-12s %s' % (mp, ' '.join(row)))
    return ok_all


