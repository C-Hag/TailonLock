        if baseline:
            os.makedirs(os.path.dirname(refgz), exist_ok=True)
            with open(cur, 'rb') as f, gzip.open(refgz, 'wb', 9) as gz:
                gz.write(f.read())
            say('    %-14s reference taken' % label)
            continue
        if not os.path.exists(refgz):
            say('    %-14s no reference' % label)
            ok_all = False
            continue
        ref = os.path.join(work, '%s-%s-ref.bmp' % (st, n))
        with gzip.open(refgz, 'rb') as gz, open(ref, 'wb') as f:
            f.write(gz.read())
        rc, out = run([cmp_exe, 'bmp', ref, cur])
