    sub = ap.add_subparsers(dest='cmd', required=True)
    r = sub.add_parser('run')
    r.add_argument('--quick', action='store_true')
    r.add_argument('--jobs', type=int, default=4)
    w = sub.add_parser('windows')
    w.add_argument('--exe', default=os.path.join(ROOT, 'build', 'windows-mingw', 'TailonLock.exe'))
    w.add_argument('--vm-logs', required=True)
    w.add_argument('--offline', type=int, default=28)
    w.add_argument('--network', type=int, default=20)
    c = sub.add_parser('cross')
    c.add_argument('--name', required=True, choices=['linux-macos', 'linux-windows', 'macos-windows'])
    c.add_argument('--games', type=int, default=20)
    c.add_argument('logs', nargs='+')
    rl = sub.add_parser('release')
    rl.add_argument('certs', nargs='+')
    rl.add_argument('--hands-on', required=True, nargs='+', help='one ticked checklist per system')
    v = sub.add_parser('verify')
    v.add_argument('cert')
    d = sub.add_parser('digest', help='the digest of audit logs (--audit --part sorties, TL_AUDIT_DEATHS=1) and the reference')
    d.add_argument('logs', nargs='+')
    pl = sub.add_parser('plat', help='the platform layer\'s brick ladder, P0-P7')
    pl.add_argument('--fuzz', type=int, default=60, help='seconds of fuzzing in P1')
    pl.add_argument('--sound', type=int, default=600, help='seconds of the sound thread under ThreadSanitizer in P4')
    pl.add_argument('--sdl-exe', help='the SDL build of the same commit, for the frame time in P6')
    pl.add_argument('--skip-certify', action='store_true', help='stop before P7 (the ladder then ends unfinished)')
    pw = sub.add_parser('plat-windows')
