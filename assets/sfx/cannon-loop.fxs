# cannon-loop: cannon fire: noise crack with a pulse thump, 12.5 rounds/s (loop)
tl-sfx 1
play loop 16
volume f
wave mutew
  08 +0
  00 +0
  end
instrument mute ad=00 sr=00 wave=mutew
wave shotw
  81 =5a
  41 =24
  81 =44
  81 =3c
  81 =36
  end
wave thumpw
  41 =26
  41 =1e
  41 =18
  41 =13
  10 =10
  end
wave brassw
  81 =50
  81 =4c
  end
pulse p8
  set 800 01
  end
instrument shot ad=05 sr=00 wave=shotw pulse=p8
instrument thump ad=06 sr=00 wave=thumpw pulse=p8
instrument brass ad=02 sr=00 wave=brassw
track 1
  @loop C-4:shot + + - C-4:shot + + - C-4:shot + + - C-4:shot + + -
track 2
  @loop C-4:thump + + + - - - - C-4:thump + + + - - - -
track 3
  @loop - - C-4:brass - - - C-4:brass - - - C-4:brass - - - C-4:brass -
