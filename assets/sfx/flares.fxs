# flares: flare dispenser: four pops with rising blips, then a fading sizzle
tl-sfx 1
play once 1.8
volume f
wave mutew
  08 +0
  00 +0
  end
instrument mute ad=00 sr=00 wave=mutew
wave popw
  81 =5c
  41 =40
  41 =44
  41 =48
  41 =4c
  81 =50
  end
wave sizzw
  81 =58
  81 =55
  81 =5a
  81 =56
  loop 0
wave thw
  41 =24
  41 =1c
  10 =10
  end
pulse p4
  set 400 01
  end
instrument pop ad=04 sr=00 wave=popw pulse=p4
instrument sizz ad=48 sr=7a wave=sizzw
instrument th ad=04 sr=00 wave=thw pulse=p4
track 1
  C-4:pop + + + + + - - - C-4:pop + + + + + -
  - - C-4:pop + + + + + - - - C-4:pop + + + +
  + - - - - - - - - - - - - - - -
  @loop C-4:mute - - - - - - - - - - - - - - -
track 2
  - - - - - - C-4:sizz + + + + + + + + +
  + + + + + + + + + + + + + + + +
  + + + + - - - - - - - - - - - -
  @loop C-4:mute - - - - - - - - - - - - - - -
track 3
  C-4:th + + - - - - - - C-4:th + + - - - -
  - - C-4:th + + - - - - - - C-4:th + + - -
  @loop C-4:mute - - - - - - - - - - - - - - -
