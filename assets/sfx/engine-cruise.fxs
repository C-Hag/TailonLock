# engine-cruise: jet engine cruise: brighter rumble, faster throb, higher whine (loop)
tl-sfx 1
play loop 384
volume f
wave mutew
  08 +0
  00 +0
  end
instrument mute ad=00 sr=00 wave=mutew
wave rumw
  81 =2c
  81 =2e
  81 =2b
  81 =2d
  loop 0
wave throbw
  41 +0
  end
wave whinew
  11 +0
  end
pulse throbp
  set 200 01
  add 008 64
  add -008 64
  loop 1
filter rumf
  set lp 300 6 1
  add 040 32
  add -040 32
  loop 1
instrument rum ad=a0 sr=f0 wave=rumw filter=rumf flags=filteron
instrument throb ad=a0 sr=a0 wave=throbw pulse=throbp
instrument whine ad=a0 sr=40 wave=whinew
command wob vib 0c 05
track 1
  C-4:rum + + + + + + + + + + + + + + +
  @loop + + + + + + + + + + + + + + + +
track 2
  D-2:throb + + + + + + + + + + + + + + +
  @loop + + + + + + + + + + + + + + + +
track 3
  E-6:whine:wob + + + + + + + + + + + + + + +
  @loop + + + + + + + + + + + + + + + +
