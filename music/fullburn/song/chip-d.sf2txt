# Full Burn - SID D: guitar (the right guitar take, transcribed). Generated by
# compose_sidguitar.py; compile with sf2gen. 6-frame sixteenths, in sync with SID A and B.
# Voices: 1 = root, 2 = fifth, 3 = octave (or major 10th for open chords). One shared filter.
tempo 6
volume f
chunk 16
hr 0f 00

wave gw                 # pick: one frame of noise, then pulse
  81 =4c
  41 +0
  end
wave gw5
  81 =4c
  41 +7
  end
wave gw8
  81 =4c
  41 +12
  end
wave gw10
  81 =4c
  41 +16
  end
wave mw
  81 =48
  41 +0
  end
wave mw5
  81 =48
  41 +7
  end
wave mw8
  81 =48
  41 +12
  end
wave scrw
  81 =5a
  81 =56
  81 =52
  80 =50
  end

pulse gp                # width tuned to his harmonic balance, slow sweep
  set 380 01
  add 008 30
  add -008 30
  loop 1
pulse mp
  set 500 01
  add 020 30
  add -020 30
  loop 1

filter gopenf           # his brightness decay: open on the pick, closing fast, then settling
  set lp 500 3 7
  add -040 10
  end
filter gpmf             # palm mute: darker and shorter
  set lp 200 1 7
  add -040 06
  end

instrument go   ad=08 sr=4c wave=gw   pulse=gp filter=gopenf flags=filteron
instrument go5  ad=08 sr=4c wave=gw5  pulse=gp flags=filteron
instrument go8  ad=08 sr=4c wave=gw8  pulse=gp flags=filteron
instrument go10 ad=08 sr=4c wave=gw10 pulse=gp flags=filteron
instrument gm   ad=08 sr=71 wave=mw   pulse=mp filter=gpmf flags=filteron
instrument gm5  ad=08 sr=71 wave=mw5  pulse=mp flags=filteron
instrument gm8  ad=08 sr=71 wave=mw8  pulse=mp flags=filteron
instrument scr  ad=02 sr=00 wave=scrw

# ---- v2 solo instruments: lead single notes, bends, tapping, the dive, double stops
wave glw
  81 =4c
  41 +0
  end
wave gbendw             # pick, then bend up a whole tone over 9 frames
  81 =4c
  41 +0
  41 +0
  41 +0
  41 +1
  41 +1
  41 +1
  41 +2
  end
pulse glp
  set 380 01
  add 008 30
  add -008 30
  loop 1
filter glf              # his brightness decay, a little longer for single notes
  set lp 600 3 3
  add -020 10
  end
filter gdivef           # the dive: the filter closes over two seconds
  set lp 700 6 3
  add -008 ff
  end
arp tapE 0 3 7 12 15 19 24 19 15 12 7 3
instrument gl    ad=08 sr=ca wave=glw    pulse=glp filter=glf flags=hr,filteron
instrument gl2   ad=08 sr=ba wave=glw    pulse=glp flags=hr,filteron
instrument gbend ad=08 sr=ca wave=gbendw pulse=glp filter=glf flags=hr,filteron
instrument gtap  ad=06 sr=b8 wave=glw    pulse=glp filter=glf flags=filteron
instrument gdive ad=08 sr=cb wave=glw    pulse=glp filter=gdivef flags=hr,filteron
command tap  arp 00 tapE
command dive slide ffa0
command vib  vib 04 03                  # the guitar melody's vibrato: short and light



