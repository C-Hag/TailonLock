# Full Burn 80s buzz lead - SID E: the melody with the opening's buzz (DMX9: h2h-solo take A on riff 2, bars 41-44).
tempo 6
volume f
chunk 16
hr 0f 00
wave bzw                # the opening arpeggio's narrow sweeping pulse, held
  41 +0
  end
pulse bzp
  set 300 01
  add 020 20
  add -020 20
  loop 1
instrument bz ad=08 sr=c9 wave=bzw pulse=bzp flags=hr
instrument bzh ad=08 sr=89 wave=bzw pulse=bzp flags=hr   # the harmony
command vib  vib 04 02
command sw1  none delay=1
command bnd0d9 porta 00d9


