# Full Burn - SID B (arpeggios, counter-line/pad, harmony, jet). Tailon Lock (2026).
# Generated by compose.py; compile with sf2gen. 6-frame sixteenths, in sync with SID A.
tempo 6
volume f
chunk 16
hr 0f 00

wave arpw
  41 +0
  end
wave padw               # saw pad
  21 +0
  end
wave harmw
  41 +0
  end
wave jetw
  81 +0
  end

pulse arpp
  set 300 01
  add 020 20
  add -020 20
  loop 1
pulse harmp
  set 700 01
  add 008 40
  add -008 40
  loop 1

filter padf             # the pad's low-pass breathing slowly (moderate resonance)
  set lp 300 5 2
  add 004 60
  add -004 60
  loop 1
filter sweepf           # bridge: one long sweep up over eight bars
  set lp 100 7 2
  add 003 ff
  add 003 ff
  add 002 ff
  end
filter jetf             # jet spool-up: low-pass opening, low resonance (no whistle)
  set lp 0a0 2 4
  add 002 ff
  add 003 ff
  add 002 80
  end

instrument arp    ad=04 sr=00 wave=arpw   pulse=arpp
instrument pad1   ad=8a sr=a9 wave=padw   filter=padf flags=hr,filteron
instrument padsw  ad=8a sr=a9 wave=padw   filter=sweepf flags=hr,filteron
instrument pad    ad=8a sr=a9 wave=padw   flags=hr,filteron
instrument harm   ad=09 sr=99 wave=harmw  pulse=harmp flags=hr
instrument jet    ad=f0 sr=f9 wave=jetw   filter=jetf flags=filteron

command vib  vib 04 02



