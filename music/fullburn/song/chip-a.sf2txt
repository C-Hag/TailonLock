# Full Burn - SID A (drums, bass, lead). Tailon Lock (2026). Generated by compose.py; compile with sf2gen.
# 6-frame sixteenths: 125.3 BPM, 16 rows a bar. Plays in sync with SID B (fullburn-b.sf2).
tempo 6
volume f
chunk 16
hr 0f 00

wave kickw              # big kick: click, triangle/pulse sweep down
  81 =4a
  41 =2c
  11 =26
  11 =21
  11 =1d
  11 =1a
  11 =17
  11 =15
  end
wave snarew             # fat snare: pulse body, noise tail
  41 =2c
  81 =5a
  41 =24
  81 =56
  81 =54
  81 =52
  81 =50
  81 =4e
  end
wave hatw
  81 =5c
  81 =5a
  end
wave tomw               # tom: pulse with a falling pitch from the played note
  81 =40
  11 +7
  11 +5
  11 +3
  11 +2
  11 +1
  11 +0
  end
wave bassw
  41 +0
  end
wave leadw
  41 +0
  end
wave solow
  81 =50
  41 +0
  end

pulse bassp
  set 500 01
  add 018 30
  add -018 30
  loop 1
pulse leadp
  set 600 01
  add 010 40
  add -010 40
  loop 1
pulse solop
  set 200 01
  add 040 0c
  add -040 0c
  loop 1
pulse snp
  set 800 01
  end

instrument kick   ad=08 sr=00 wave=kickw  pulse=snp
instrument snare  ad=09 sr=00 wave=snarew pulse=snp
instrument hat    ad=02 sr=00 wave=hatw   pulse=snp
instrument tom    ad=08 sr=00 wave=tomw   pulse=snp
instrument bass   ad=07 sr=00 wave=bassw  pulse=bassp flags=hr
instrument bassl  ad=aa sr=8a wave=bassw  pulse=bassp flags=hr
instrument lead   ad=09 sr=a9 wave=leadw  pulse=leadp flags=hr
instrument leadc  ad=09 sr=c9 wave=leadw  pulse=leadp flags=hr
instrument solo   ad=08 sr=c8 wave=solow  pulse=solop flags=hr

command vib  vib 04 02



