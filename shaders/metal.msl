// metal.msl - the GPU renderer's shaders in Metal's shading language, for
// macOS: the same maths as the HLSL files beside it (common.hlsli, world,
// sky, sprite, line, post), one entry point per shader. tools/embed_msl.py
// writes it into src/gpu_msl.h; our Metal device (src/platform/gx_metal.m)
// compiles it when the game starts.
//
// Bindings are gx.h's slots: uniform buffers [[buffer(0..1)]] per stage,
// textures and their samplers [[texture(n)]] / [[sampler(n)]], the vertex
// buffer described by the pipeline ([[stage_in]], at a buffer index of its
// own past the uniforms).
// The matrices are stored row by row (HLSL row_major); Metal reads them
// column by column, so mul(M, v) becomes v * M here.
#include <metal_stdlib>
using namespace metal;

struct ViewData {
  float4x4 viewProj;
  float4x4 shadowVP;
  float4 camPos;   // xyz, w: time in seconds
  float4 camRight; // xyz, w: 1 / horizontal projection scale
  float4 camUp;    // xyz, w: 1 / vertical projection scale
  float4 camFwd;   // xyz, w: focal length in pixels of the viewport height
  float4 sunDir;   // toward the sun; w: sun intensity
  float4 sunCol;   // rgb; w: 1 when the shadow map is live
  float4 ambCol;   // rgb; w: ambient intensity
  float4 skyTop;   // rgb; w: star brightness
  float4 skyHor;   // rgb; w: water level
  float4 fogCol;   // rgb; w: fog density per metre
  float4 misc;     // x: fog start, y: classic arena, z: shadow texel size, w: the sea: 3 the opening film, 2 ULTRA, else 1
  float4 haze;     // rgb: the ground beyond what is drawn; w: the most a surface fades into the fog
};

static float3 to_linear(float3 c) { return c * c; }

static float3 sky_color(constant ViewData &v, float3 d, bool disc) {
  float h = saturate(d.y);
  float3 top = to_linear(v.skyTop.rgb), hor = to_linear(v.skyHor.rgb);
  float3 c = mix(hor, top, pow(h, 0.45));
  // below the horizon: the far ground's haze, from where surfaces stop fading (so the sky ends at the level line)
  // (haze.w < 0: the hangar's studio backdrop, which darkens from the horizon colour below the eye line)
  if (d.y < 0) c = v.haze.w < 0 ? mix(hor, to_linear(v.fogCol.rgb) * 0.8, saturate(-d.y * 4))
                             : mix(to_linear(v.haze.rgb), to_linear(v.fogCol.rgb), v.haze.w);
  float s = saturate(dot(d, normalize(v.sunDir.xyz)));
  float3 sun = to_linear(v.sunCol.rgb) * v.sunDir.w;
  c += sun * (pow(s, 6.0) * 0.25 + pow(s, 64.0) * 0.6);
  if (disc && s > 0.9996) c += sun * 40;
  return c;
}

static float3 apply_fog(constant ViewData &v, float3 c, float3 wp) {
  float3 d = wp - v.camPos.xyz;
  float dist = length(d);
  float3 dir = d / max(dist, 1e-3);
  float hf = exp(-max(0.0, min(wp.y, v.camPos.y) - v.skyHor.w) / 1800.0);
  float f = 1 - exp(-max(0.0, dist - v.misc.x) * v.fogCol.w * (0.35 + 0.65 * hf));
  float s = pow(saturate(dot(dir, normalize(v.sunDir.xyz))), 8.0);
  float3 fc = mix(to_linear(v.fogCol.rgb), to_linear(v.sunCol.rgb) * v.sunDir.w, s * 0.5);
  return mix(c, fc, v.haze.w < 0 ? saturate(f) : min(saturate(f), v.haze.w));
}

static float hash21(float2 p) {
  p = fract(p * float2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

static float vnoise(float2 p) {
  float2 i = floor(p), f = fract(p);
  float2 u = f * f * (3 - 2 * f);
  return mix(mix(hash21(i), hash21(i + float2(1, 0)), u.x), mix(hash21(i + float2(0, 1)), hash21(i + float2(1, 1)), u.x), u.y);
}

// ---- world: meshes, terrain, the sea --------------------------------------------
struct Inst {
  float4 R, U, F, Pos; // basis; Pos.w: scale
  float4 Tint;         // x: dim, y: gloss, z: ground detail, w: cull box on
  float4 CullMin, CullMax;
};

struct WorldIn {
  float3 pos [[attribute(0)]];
  float3 nrm [[attribute(1)]];
  float4 col [[attribute(2)]];
};
struct WorldOut {
  float4 clip [[position]];
  float3 wp;
  float3 n;
  float4 col;
  float3 lp;
};

vertex WorldOut world_vs(WorldIn i [[stage_in]], constant ViewData &VV [[buffer(0)]], constant Inst &I [[buffer(1)]]) {
  WorldOut o;
  float3 w = I.Pos.xyz + (I.R.xyz * i.pos.x + I.U.xyz * i.pos.y + I.F.xyz * i.pos.z) * I.Pos.w;
  o.clip = float4(w, 1) * VV.viewProj;
  o.wp = w;
  o.n = I.R.xyz * i.nrm.x + I.U.xyz * i.nrm.y + I.F.xyz * i.nrm.z;
  o.col = i.col;
  o.lp = i.pos;
  return o;
}

static float shadow_at(constant ViewData &v, depth2d<float> tex, sampler smp, float3 wp, float3 n) {
  if (v.sunCol.w < 0.5) return 1;
  float4 s = float4(wp + n * 0.6, 1) * v.shadowVP;
  float2 uv = float2(s.x * 0.5 + 0.5, 0.5 - s.y * 0.5);
  if (any(uv < 0.0) || any(uv > 1.0) || s.z > 1) return 1;
  float t = v.misc.z, sum = 0;
  for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++)
      sum += tex.sample_compare(smp, uv + float2(x, y) * t, s.z - 0.0015);
  return sum / 9;
}

static float sea_height(float2 p, float t) {
  float h = sin(dot(p, float2(0.011, 0.007)) + t * 0.8) * 0.6 + sin(dot(p, float2(-0.006, 0.015)) + t * 1.1) * 0.4;
  h += vnoise(p * 0.035 + float2(t * 0.05, t * 0.03)) * 1.1;
  h += vnoise(p * 0.11 - float2(t * 0.09, -t * 0.04)) * 0.45;
  h += vnoise(p * 0.37 + float2(t * 0.2, t * 0.13)) * 0.14;
  return h;
}

static float2 wave_slope(float2 p, float t) {
  const float e = 0.8;
  float h0 = sea_height(p, t);
  return float2(sea_height(p + float2(e, 0), t) - h0, sea_height(p + float2(0, e), t) - h0) / e * 1.6;
}

fragment float4 world_fs(WorldOut i [[stage_in]], constant ViewData &v [[buffer(0)]], constant Inst &I [[buffer(1)]],
                         depth2d<float> ShadowTex [[texture(0)]], sampler ShadowSmp [[sampler(0)]]) {
  if (I.Tint.w > 0.5 && all(i.lp > I.CullMin.xyz) && all(i.lp < I.CullMax.xyz)) discard_fragment();
  float3 V = normalize(v.camPos.xyz - i.wp);
  float3 L = normalize(v.sunDir.xyz);
  float3 N = normalize(i.n);
  if (dot(N, V) < 0) N = -N;
  float3 sun = to_linear(v.sunCol.rgb) * v.sunDir.w;
  float3 amb = to_linear(v.ambCol.rgb) * v.ambCol.w;
  float sh = shadow_at(v, ShadowTex, ShadowSmp, i.wp, N);
  float3 c;
  if (i.col.a >= 0.5 && i.col.a < 0.9 && I.Tint.z <= 0.5) { // (on the ground the alpha is the land's share: only its middle is the coast)
    // glowing screens and lights: emitted, not lit
    c = to_linear(i.col.rgb) * 2.4;
  } else if (i.col.a < 0.5) {
    // water
    float dist = length(v.camPos.xyz - i.wp);
    float2 sl = wave_slope(i.wp.xz, v.camPos.w) * saturate(1.3 - dist / 7000);
    // waves finer than a pixel cannot be drawn: they would only sparkle from frame to frame, through a long lens
    // most of all. Calm the slope and spread the sun's highlight (same energy) by how much sea one pixel covers.
    float seaPx = length(fwidth(i.wp.xz));
    bool fineSea = v.misc.w > 1.5; // at ULTRA and in the film: a long swell, wide enough to draw, and a shore
    bool filmSea = v.misc.w > 2.5; // the opening film's sea: seen from high up at dawn, it must not go flat and dark
    sl /= 1 + seaPx * (filmSea ? 1.2 : 0.3);
    if (fineSea) sl += wave_slope(i.wp.xz * 0.13, v.camPos.w * 0.45) * 0.55 / (1 + seaPx * 0.12);
    float3 Nw = normalize(float3(-sl.x, 1, -sl.y));
    // at grazing angles a wavy sea mirrors less than a calm one, and the sky above the haze: so the sea stays
    // the sea right up to the horizon instead of melting into the sky there
    float fres = 0.02 + 0.68 * pow(1 - saturate(dot(Nw, V)), 5.0);
    if (filmSea) fres = max(fres, 0.2);
    float3 R = reflect(-V, Nw);
    R.y = max(abs(R.y), 0.12);
    float3 deep = to_linear(i.col.rgb) * (amb * 0.6 + sun * 0.25 * saturate(L.y));
    if (filmSea) deep = float3(0.04, 0.12, 0.17) * (amb + sun * 0.55);
    c = mix(deep, sky_color(v, R, false), saturate(fres));
    float3 H = normalize(L + V);
    float glint = 600 / (1 + seaPx * seaPx * 30);
    c += sun * pow(saturate(dot(Nw, H)), glint) * 12 * (glint / 600) * sh;
    float foam = smoothstep(0.78, 0.98, vnoise(i.wp.xz * 0.06 + v.camPos.w * 0.15) * vnoise(i.wp.xz * 0.23 - v.camPos.w * 0.1) * 2.0);
    if (filmSea) c += sun * pow(saturate(dot(R, L)), 90.0) * 0.28 * sh; // the sun's broad path on the swell
    if (fineSea && I.Tint.z > 0.5) {
      // towards the coast: lighter water over the sand, and a broken line of surf where it meets the land
      float shore = smoothstep(0.2, 0.5, i.col.a);
      c = mix(c, float3(0.05, 0.30, 0.33) * (amb + sun * 0.55), shore * 0.55);
      float surf = smoothstep(0.46, 0.5, i.col.a) * smoothstep(0.35, 0.65, vnoise(i.wp.xz * 0.07 + v.camPos.w * 0.12));
      c = mix(c, (amb + sun * 0.55) * 0.85, surf * 0.35);
    }
    if (fineSea) foam *= 0.28 * saturate(1.2 - seaPx * 0.8); // whitecaps smaller than a pixel only speckle
    c = mix(c, (amb + sun * 0.4) * 0.8, foam * 0.18 * saturate(1 - dist / 3000));
  } else {
    float3 albedo = to_linear(i.col.rgb) * I.Tint.x;
    if (I.Tint.z > 0.5) {
      // ground: two octaves of noise, rock on steep slopes
      float n1 = vnoise(i.wp.xz * 0.02), n2 = vnoise(i.wp.xz * 0.15), n3 = vnoise(i.wp.xz * 1.1);
      albedo *= 0.78 + 0.28 * n1 + 0.14 * n2 + 0.06 * n3;
      float rock = smoothstep(0.82, 0.6, N.y);
      albedo = mix(albedo, float3(0.16, 0.15, 0.14) * (0.8 + 0.4 * n2), rock * 0.7);
      if (v.misc.w > 1.5) albedo = mix(albedo, float3(0.52, 0.42, 0.24) * (0.85 + 0.25 * n2), smoothstep(0.6, 0.5, i.col.a)); // the beach
    }
    float wet = 1;
    if (v.misc.w > 1.5 && I.Tint.y > 0) {
      // ULTRA, a jet's skin up close: panel lines, frames across the fuselage and ribs along it, in the model's own metres,
      // gone before a pixel gets too big to show them (no shimmer in the distance); weathering streaks with the airflow
      float3 pw = fwidth(i.lp), nl = abs(normalize(cross(dfdx(i.lp), dfdy(i.lp))));
      const float3 cell = float3(2.3, 0.9, 1.9);
      // each row of panels starts at its own place, as real skin does, so the lines are no grid
      float row = floor(i.lp.x / cell.x);
      float3 at = i.lp + float3(0, 0, 0.71 * row);
      float3 dist = (0.5 - abs(fract(at / cell) - 0.5)) * cell;
      float3 line_ = (1 - smoothstep(float3(0.007), float3(0.007) + pw * 1.3, dist)) * (1 - nl);
      float show = saturate(1.5 - max(pw.x, max(pw.y, pw.z)) * 11);
      float ln = max(line_.x, max(line_.y, line_.z)) * show;
      float streak = vnoise(float2(i.lp.x * 6.5, i.lp.z * 0.55)), blotch = vnoise(i.lp.xz * 0.9 + i.lp.yy * 1.7);
      albedo *= (1 - 0.24 * ln) * (0.9 + 0.13 * streak) * (0.93 + 0.14 * blotch);
      wet = (0.65 + 0.7 * streak) * (1 - 0.7 * ln);
    }
    float diff = saturate(dot(N, L));
    float3 hemi = amb * (0.55 + 0.45 * N.y) + to_linear(v.fogCol.rgb) * 0.12 * (1 - N.y);
    c = albedo * (hemi + sun * diff * sh);
    if (I.Tint.y > 0) {
      float3 H = normalize(L + V);
      float fres = 0.04 + 0.96 * pow(1 - saturate(dot(N, V)), 5.0);
      c += sun * pow(saturate(dot(N, H)), 48.0) * I.Tint.y * wet * (0.25 + fres) * sh;
      c += sky_color(v, reflect(-V, N), false) * fres * I.Tint.y * 0.25;
    }
  }
  c = apply_fog(v, c, i.wp);
  return float4(c, 1);
}

// ---- shadow map: depth only ------------------------------------------------------
struct ShadowOut { float4 clip [[position]]; };

vertex ShadowOut shadow_vs(WorldIn i [[stage_in]], constant ViewData &VV [[buffer(0)]], constant Inst &I [[buffer(1)]]) {
  ShadowOut o;
  float3 w = I.Pos.xyz + (I.R.xyz * i.pos.x + I.U.xyz * i.pos.y + I.F.xyz * i.pos.z) * I.Pos.w;
  o.clip = float4(w, 1) * VV.shadowVP;
  return o;
}
fragment void shadow_fs() {}

// ---- sky: gradient, sun and stars along each pixel's ray ------------------------
struct SkyOut {
  float4 clip [[position]];
  float2 ndc;
};

vertex SkyOut sky_vs(uint id [[vertex_id]]) {
  SkyOut o;
  float2 p = float2((id << 1) & 2, id & 2) * 2 - 1;
  o.clip = float4(p, 0, 1);
  o.ndc = p;
  return o;
}

fragment float4 sky_fs(SkyOut i [[stage_in]], constant ViewData &v [[buffer(0)]]) {
  float3 d = normalize(v.camFwd.xyz + v.camRight.xyz * i.ndc.x * v.camRight.w + v.camUp.xyz * i.ndc.y * v.camUp.w);
  float3 c = sky_color(v, d, true);
  if (v.skyTop.w > 0.01 && d.y > 0.02) {
    float2 q = float2(atan2(d.x, d.z) * 380, d.y * 600);
    float2 cell = floor(q);
    float h = hash21(cell);
    float tw = 0.7 + 0.3 * sin(v.camPos.w * 3 + h * 40);
    float2 f = fract(q) - 0.5;
    if (h > 0.985) c += v.skyTop.w * tw * smoothstep(0.35, 0.0, length(f)) * (h - 0.985) * 120;
  }
  return float4(c, 1);
}

// ---- sprites: smoke, fire, flares, cloud puffs (premultiplied alpha) ------------
struct SpriteIn {
  float4 posSize [[attribute(0)]]; // xyz, world radius
  float4 col [[attribute(1)]];     // rgb, alpha
  float4 par [[attribute(2)]];     // x: kind, y: min pixels, z: seed
};
struct SpriteOut {
  float4 clip [[position]];
  float2 uv;
  float4 col;
  float4 par;
  float3 wp;
};

vertex SpriteOut sprite_vs(SpriteIn i [[stage_in]], uint id [[vertex_id]], constant ViewData &VV [[buffer(0)]]) {
  const float2 C[6] = { float2(-1, -1), float2(1, -1), float2(1, 1), float2(-1, -1), float2(1, 1), float2(-1, 1) };
  float2 c = C[id % 6];
  float z = max(dot(i.posSize.xyz - VV.camPos.xyz, VV.camFwd.xyz), 0.5);
  float r = max(i.posSize.w, i.par.y * 0.5 * z / VV.camFwd.w);
  float3 w = i.posSize.xyz + (VV.camRight.xyz * c.x + VV.camUp.xyz * c.y) * r;
  SpriteOut o;
  o.clip = float4(w, 1) * VV.viewProj;
  o.uv = c;
  o.col = i.col;
  o.par = i.par;
  o.wp = i.posSize.xyz;
  return o;
}

fragment float4 sprite_fs(SpriteOut i [[stage_in]], constant ViewData &v [[buffer(0)]]) {
  float r2 = dot(i.uv, i.uv);
  if (r2 > 1) discard_fragment();
  int kind = (int)i.par.x;
  float3 c = to_linear(i.col.rgb);
  float a = i.col.a;
  if (kind == 1) {
    // cloud puff: a lit sphere with a ragged rim
    float3 n = normalize(v.camRight.xyz * i.uv.x + v.camUp.xyz * i.uv.y - v.camFwd.xyz * sqrt(1 - r2));
    float lit = 0.72 + 0.4 * saturate(dot(n, normalize(v.sunDir.xyz)));
    float rim = vnoise(i.uv * 3 + i.par.z * 17) * 0.35;
    a *= smoothstep(1.0, 0.55 - rim * 0.3, r2 + rim * 0.35);
    c = apply_fog(v, c * lit, i.wp);
    return float4(c * a, a);
  }
  if (kind == 2) {
    // glow: hot core, added on top
    float g = pow(1 - r2, 2.2);
    return float4(c * g * a * 3.0, 0);
  }
  // soft particle
  a *= pow(1 - r2, 1.4);
  c = apply_fog(v, c, i.wp);
  return float4(c * a, a);
}

// ---- lines: tracers, missile bodies, the tanker's hose ---------------------------
struct LineIn {
  float3 pos [[attribute(0)]];
  float4 col [[attribute(1)]]; // linear HDR rgb, alpha
};
struct LineOut {
  float4 clip [[position]];
  float4 col;
};

vertex LineOut line_vs(LineIn i [[stage_in]], constant ViewData &VV [[buffer(0)]]) {
  LineOut o;
  o.clip = float4(i.pos, 1) * VV.viewProj;
  o.col = i.col;
  return o;
}

fragment float4 line_fs(LineOut i [[stage_in]]) { return float4(i.col.rgb * i.col.a, i.col.a); }

// ---- post: bright pass, blur, tonemap and the HUD on top -------------------------
struct PostData {
  float4 P;  // x: exposure, y: bloom strength, z/w: blur step (uv)
  float4 G;  // film grade: warm tint, vignette, grain, time
  float4 Hz; // heat haze: band y0, y1 (uv), strength (uv), time
  float4 D;  // x: weight of the main picture over the second (dissolve), y: whip smear (uv)
};
struct PostOut {
  float4 clip [[position]];
  float2 uv;
};

vertex PostOut post_vs(uint id [[vertex_id]]) {
  PostOut o;
  float2 p = float2((id << 1) & 2, id & 2);
  o.clip = float4(p * 2 - 1, 0, 1);
  o.uv = float2(p.x, 1 - p.y);
  return o;
}

fragment float4 bright_fs(PostOut i [[stage_in]], texture2d<float> Tex0 [[texture(0)]], sampler Smp0 [[sampler(0)]]) {
  float3 c = Tex0.sample(Smp0, i.uv).rgb;
  float l = max(c.r, max(c.g, c.b));
  return float4(c * saturate((l - 1.0) / max(l, 1e-4)), 1);
}

fragment float4 blur_fs(PostOut i [[stage_in]], constant PostData &U [[buffer(0)]], texture2d<float> Tex0 [[texture(0)]],
                        sampler Smp0 [[sampler(0)]]) {
  const float w[5] = { 0.227, 0.194, 0.121, 0.054, 0.016 };
  float3 c = Tex0.sample(Smp0, i.uv).rgb * w[0];
  for (int k = 1; k < 5; k++) {
    c += Tex0.sample(Smp0, i.uv + U.P.zw * k).rgb * w[k];
    c += Tex0.sample(Smp0, i.uv - U.P.zw * k).rgb * w[k];
  }
  return float4(c, 1);
}

static float3 aces(float3 x) { return saturate((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }

fragment float4 final_fs(PostOut i [[stage_in]], constant PostData &U [[buffer(0)]],
                         texture2d<float> Tex0 [[texture(0)]], sampler Smp0 [[sampler(0)]],
                         texture2d<float> Tex1 [[texture(1)]], sampler Smp1 [[sampler(1)]],
                         texture2d<float> Tex2 [[texture(2)]], sampler Smp2 [[sampler(2)]],
                         texture2d<float> Tex3 [[texture(3)]], sampler Smp3 [[sampler(3)]]) {
  float2 uv = i.uv;
  if (U.Hz.z > 0 && uv.y > U.Hz.x && uv.y < U.Hz.y) {
    // heat shimmer, stronger toward the bottom of the band
    float k = (uv.y - U.Hz.x) / max(U.Hz.y - U.Hz.x, 1e-3);
    uv.x += sin(uv.y * 480 + U.Hz.w * 23) * sin(uv.y * 70 - U.Hz.w * 7) * U.Hz.z * k;
  }
  float3 hdr = float3(0);
  int n = U.D.y != 0 ? 16 : 1;
  for (int k = 0; k < n; k++) {
    float2 q = uv + float2(U.D.y * 4.0 * k / 16.0, 0);
    float3 s = Tex0.sample(Smp0, q).rgb + Tex1.sample(Smp1, q).rgb * U.P.y;
    if (U.D.x < 1) s = mix(Tex3.sample(Smp3, q).rgb, s, U.D.x);
    hdr += s / n;
  }
  float3 c = pow(aces(hdr * U.P.x), 1 / 2.2);
  float2 d = i.uv - 0.5;
  c *= 1 - dot(d, d) * (0.35 + U.G.y * 2.2);
  c *= 1 + U.G.x * float3(0.5, 0.1, -0.4);
  uint2 q = uint2(i.clip.xy);
  uint h = q.x * 1973u + q.y * 9277u + uint(U.G.w * 60.0) * 26699u;
  h = (h ^ (h >> 15)) * 0x2c1b3c6du;
  h = (h ^ (h >> 12)) * 0x297a2d39u;
  h ^= h >> 15;
  float nz = float(h & 0xffffu) / 65535.0;
  c += (nz - 0.5) * U.G.z * 0.45;
  float4 ov = Tex2.sample(Smp2, i.uv);
  return float4(ov.rgb + c * (1 - ov.a), 1);
}
